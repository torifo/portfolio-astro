---
// OfficialEmbeds.astro - 聖地巡礼の作品のページに、公式の PV（YouTube）と公式サイトのカードを置く。
// キャラクターの絵は権利者のものとして表示する（画像をこちらに置かない）。公式サイトの画像は無断利用を禁じている作品があるため。
// YouTube は最初はサムネだけを出し、押したら動画を読み込む（ページを重くしない。youtube-nocookie）。
// 公式サイトのカードの画像は、サイトがリンク共有用に出している og:image を公式サイトから直接出す（SNS のリンクカードと同じ）。
// 公式 X の埋め込みはやめた（ログイン状態やブラウザの追跡防止で出ないことが多く、更新の止まったアカウントもあった）。
// シリーズが2件以上ある作品は、期ごとの PV と公式サイトを同じ大きさのサムネで並べる（収まらなければ流れる帯。ReelStrip.astro）。押した PV は並びの上で再生する。
import type { WorkLinks } from '../../lib/journey';
import ReelStrip from './ReelStrip.astro';

interface Props {
  title: string;
  links: WorkLinks;
}

const { title, links } = Astro.props;
const { youtube, officialSite, site, series = [] } = links;
const hostOf = (url: string) => new URL(url).host.replace(/^www\./, '');
const host = officialSite ? hostOf(officialSite) : '';
const isSeries = series.length >= 2;
const seriesVideos = series.filter((entry) => entry.youtube);

// 期ごとの公式サイト。同じ URL は1つにまとめて名前をつなげる。期のサイトが1つも無ければ作品の公式サイトを出す。
// 画像はサイトがリンク共有用に出している横長の画像（siteImage）。無い期は名前を大きく書いたカードにする
const seriesSites: { url: string; labels: string[]; image?: string }[] = [];
for (const entry of series) {
  if (!entry.officialSite) continue;
  const same = seriesSites.find((link) => link.url === entry.officialSite);
  if (same) same.labels.push(entry.label);
  else seriesSites.push({ url: entry.officialSite, labels: [entry.label], image: entry.siteImage });
}
if (!seriesSites.length && officialSite) seriesSites.push({ url: officialSite, labels: [site?.title ?? `${title} 公式サイト`], image: site?.image });
---

{isSeries && (
  <section class="official-embeds mb-10" aria-labelledby="official-heading">
    <ReelStrip name="pv" heading="公式の映像" headingId="official-heading" count={seriesVideos.length} noun="映像">
      <!-- 押した PV を出す場所。帯の中で再生すると流れて見えなくなるので、並びの上に出し、再生中は帯を止める -->
      <div slot="stage" class="pv-stage mb-2" hidden>
        <div class="pv-stage-frame relative aspect-video overflow-hidden rounded-2xl bg-black"></div>
        <div class="mt-2 flex items-start justify-between gap-3">
          <p class="pv-stage-caption text-sm text-gray-300 leading-snug"></p>
          <button type="button" class="pv-stage-close glass shrink-0 rounded-full px-3 py-1 text-xs text-gray-300 hover:text-cyan-400 transition-colors">閉じる</button>
        </div>
      </div>
      {(index: number, reachable: boolean) => {
        const entry = seriesVideos[index];
        const pv = entry.youtube!;
        return (
          <button
            type="button"
            class="pv-play group block w-full text-left"
            data-yt={pv.id}
            data-caption={`${entry.label}：${pv.title}（${pv.channel}）`}
            tabindex={reachable ? undefined : -1}
            aria-label={`${title}（${entry.label}）の PV を再生（YouTube）`}
          >
            <span class="pv-thumb relative block aspect-video overflow-hidden rounded-xl bg-black">
              <img
                src={`https://i.ytimg.com/vi/${pv.id}/hqdefault.jpg`}
                alt=""
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
              <span class="absolute inset-0 bg-linear-to-t from-black/50 to-transparent"></span>
              <span class="yt-icon absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2" aria-hidden="true">
                <svg viewBox="0 0 68 48" width="48" height="34"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.3.3 34 .3 34 .3s-21.3 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 12.9.1 24 .1 24s0 11.1 1.4 16.3a8.5 8.5 0 0 0 6 6C12.7 47.7 34 47.7 34 47.7s21.3 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35.1 67.9 24 67.9 24s0-11.1-1.4-16.3z" fill="#f00"/><path d="M45 24 27 14v20z" fill="#fff"/></svg>
              </span>
            </span>
            <span class="mt-2 block text-sm text-gray-200 font-medium leading-snug">
              {entry.label}<span class="ml-2 text-xs text-gray-400 font-normal">{entry.year}</span>
            </span>
            <span class="mt-0.5 block text-xs text-gray-400 leading-snug truncate">{pv.channel}</span>
          </button>
        );
      }}
    </ReelStrip>
    {seriesSites.length > 0 && (
      <div class="mt-4">
        <ReelStrip name="site" heading="公式サイト" level={3} count={seriesSites.length} noun="サイト">
          {(index: number, reachable: boolean) => {
            const link = seriesSites[index];
            const name = link.labels.join('・');
            return (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="site-tile group block"
                tabindex={reachable ? undefined : -1}
                aria-label={`${title}（${name}）の公式サイト（${hostOf(link.url)}・新しいタブで開く）`}
              >
                <span class="site-thumb relative block aspect-video overflow-hidden rounded-xl border border-violet-500/20 group-hover:border-violet-400/50 transition-colors">
                  {link.image ? (
                    <img
                      src={link.image}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                      class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                    />
                  ) : (
                    <span class="absolute inset-0 flex items-center justify-center bg-linear-to-br from-violet-600/60 via-sky-600/45 to-cyan-500/50 px-4">
                      <span class="site-thumb-label text-xl font-bold text-center leading-snug">{name}</span>
                    </span>
                  )}
                </span>
                <span class="mt-2 block text-sm text-gray-200 font-medium leading-snug">{name}</span>
                <span class="mt-0.5 flex items-center gap-1 text-xs text-violet-300">
                  {hostOf(link.url)}
                  <svg viewBox="0 0 20 20" width="12" height="12" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5"><path d="M7 4h9v9M16 4 5 15" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </a>
            );
          }}
        </ReelStrip>
      </div>
    )}
  </section>
)}

{!isSeries && (youtube || officialSite) && (
  <section class="official-embeds mb-10" aria-labelledby="official-heading">
    <h2 id="official-heading" class="text-sm font-semibold text-gray-400 mb-3">公式の映像・サイト</h2>
    <div class:list={['grid gap-4 items-start', { 'md:grid-cols-[3fr_2fr]': youtube && officialSite }]}>
      {youtube && (
        <div class="yt-lite relative aspect-video overflow-hidden rounded-2xl bg-black" data-yt={youtube.id}>
          <button type="button" class="yt-play group absolute inset-0 w-full h-full" aria-label={`${title}の PV を再生（YouTube）`}>
            <img
              src={`https://i.ytimg.com/vi/${youtube.id}/hqdefault.jpg`}
              alt=""
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            />
            <span class="absolute inset-0 bg-linear-to-t from-black/70 via-black/10 to-transparent"></span>
            <span class="yt-icon absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2" aria-hidden="true">
              <svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.3.3 34 .3 34 .3s-21.3 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 12.9.1 24 .1 24s0 11.1 1.4 16.3a8.5 8.5 0 0 0 6 6C12.7 47.7 34 47.7 34 47.7s21.3 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35.1 67.9 24 67.9 24s0-11.1-1.4-16.3z" fill="#f00"/><path d="M45 24 27 14v20z" fill="#fff"/></svg>
            </span>
            <span class="absolute left-4 right-4 bottom-3 text-left photo-meta text-xs truncate">{youtube.title}（{youtube.channel}）</span>
          </button>
        </div>
      )}
      {officialSite && (
        <a
          href={officialSite}
          target="_blank"
          rel="noopener noreferrer"
          class="site-card group block overflow-hidden rounded-2xl glass border border-violet-500/20 hover:border-violet-400/50 transition-colors"
        >
          {site?.image ? (
            <div class="aspect-[1.91/1] overflow-hidden bg-black/40">
              <img
                src={site.image}
                alt=""
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
          ) : (
            <div class="aspect-[1.91/1] flex items-center justify-center bg-linear-to-br from-violet-600/40 via-sky-500/25 to-cyan-400/30 px-6">
              <span class="photo-title text-lg font-bold text-center">{title}</span>
            </div>
          )}
          <div class="p-4">
            <p class="text-sm text-gray-200 font-medium leading-snug line-clamp-2">{site?.title ?? `${title} 公式サイト`}</p>
            <p class="mt-1 text-xs text-violet-300 flex items-center gap-1">
              {host}
              <svg viewBox="0 0 20 20" width="12" height="12" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5"><path d="M7 4h9v9M16 4 5 15" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </p>
          </div>
        </a>
      )}
    </div>
  </section>
)}

<script>
  // YouTube：押したら iframe を読み込む。ClientRouter の遷移ではこのスクリプトが再実行されないので、遷移のたびに繋ぎ直す（同じ要素には二重に付けない）
  function youtubeFrame(id: string): HTMLIFrameElement {
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
    iframe.title = 'YouTube';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    iframe.allowFullscreen = true;
    iframe.className = 'absolute inset-0 w-full h-full';
    return iframe;
  }

  function setupEmbeds(): void {
    // PV 1本の作品：サムネをその場で動画に差し替える
    document.querySelectorAll<HTMLElement>('.yt-lite').forEach((box) => {
      if (box.dataset.ytBound) return;
      box.dataset.ytBound = '1';
      box.querySelector('.yt-play')?.addEventListener('click', () => box.replaceChildren(youtubeFrame(box.dataset.yt!)));
    });

    // シリーズの作品：押した PV は並びの上で再生し、その間は帯を止める（data-reel-hold。動きは ReelStrip.astro）
    const reel = document.querySelector<HTMLElement>('[data-strip="pv"] [data-reel]');
    const stage = document.querySelector<HTMLElement>('.pv-stage');
    if (!reel || !stage || reel.dataset.pvBound) return;
    reel.dataset.pvBound = '1';
    const frame = stage.querySelector<HTMLElement>('.pv-stage-frame')!;
    const caption = stage.querySelector<HTMLElement>('.pv-stage-caption')!;
    const markCurrent = (id: string | null) =>
      reel.querySelectorAll<HTMLElement>('.pv-play').forEach((button) => button.toggleAttribute('data-current', button.dataset.yt === id));

    reel.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLElement>('.pv-play');
      if (!button) return;
      frame.replaceChildren(youtubeFrame(button.dataset.yt!));
      caption.textContent = button.dataset.caption ?? '';
      stage.hidden = false;
      reel.setAttribute('data-reel-hold', '');
      markCurrent(button.dataset.yt!);
      stage.scrollIntoView({ block: 'nearest' });
    });
    stage.querySelector('.pv-stage-close')?.addEventListener('click', () => {
      frame.replaceChildren();
      stage.hidden = true;
      reel.removeAttribute('data-reel-hold');
      markCurrent(null);
    });
  }

  document.addEventListener('astro:page-load', setupEmbeds);
</script>

<style>
  .yt-icon svg {
    filter: drop-shadow(0 4px 12px rgb(0 0 0 / 0.5));
    transition: transform 200ms ease-out;
  }
  .yt-play:hover .yt-icon svg,
  .yt-play:focus-visible .yt-icon svg,
  .pv-play:hover .yt-icon svg,
  .pv-play:focus-visible .yt-icon svg {
    transform: scale(1.08);
  }
  .yt-play:focus-visible,
  .pv-play:focus-visible .pv-thumb,
  .site-tile:focus-visible .site-thumb,
  .site-card:focus-visible {
    outline: 2px solid rgb(196 181 253);
    outline-offset: 2px;
  }
  .pv-play:focus-visible,
  .site-tile:focus-visible {
    outline: none;
  }
  /* 再生中の PV（並びの上に出している PV） */
  .pv-play[data-current] .pv-thumb {
    outline: 2px solid rgb(34 211 238);
    outline-offset: 2px;
  }
  /* 画像の無いサイトのカードの名前。色の帯の上なので、昼も夜も白い字に影 */
  .site-thumb-label {
    color: #fff;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.45);
  }
  @media (prefers-reduced-motion: reduce) {
    .yt-icon svg {
      transition: none;
    }
  }
</style>
