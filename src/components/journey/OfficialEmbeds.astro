---
// OfficialEmbeds.astro - 聖地巡礼の作品のページに、公式の PV（YouTube）と公式サイトのカードを置く。
// キャラクターの絵は権利者のものとして表示する（画像をこちらに置かない）。公式サイトの画像は無断利用を禁じている作品があるため。
// YouTube は最初はサムネだけを出し、押したら動画を読み込む（ページを重くしない。youtube-nocookie）。
// 公式サイトのカードの画像は、サイトがリンク共有用に出している og:image を公式サイトから直接出す（SNS のリンクカードと同じ）。
// 公式 X の埋め込みはやめた（ログイン状態やブラウザの追跡防止で出ないことが多く、更新の止まったアカウントもあった）。
// シリーズが2件以上ある作品は、期ごとの PV をトップの旅の帯と同じく横に流れ続ける帯に並べ、押した PV は帯の上で再生する。
import type { WorkLinks } from '../../lib/journey';

interface Props {
  title: string;
  links: WorkLinks;
}

const { title, links } = Astro.props;
const { youtube, officialSite, site, series = [] } = links;
const host = officialSite ? new URL(officialSite).host.replace(/^www\./, '') : '';
const isSeries = series.length >= 2;
const seriesVideos = series.filter((entry) => entry.youtube);

// 帯の1周。PV が少ないと1周が画面幅より短く、つなぎ目で途切れるので、6枚以上になるまで繰り返す（読み上げとタブ移動は最初の1回だけ）
const MIN_PER_ROUND = 6;
const repeats = Math.max(1, Math.ceil(MIN_PER_ROUND / Math.max(1, seriesVideos.length)));
const round = Array.from({ length: repeats }, (_, i) => seriesVideos.map((entry) => ({ entry, first: i === 0 }))).flat();

// 全部が横に収まる幅（1枚 220px 以上）なら流さずに並べるだけにする（本人の指示）。境目は PV の数で変わるので、ここで幅を出してコンテナクエリにする
const CARD_MIN = 220;
const fitWidth = seriesVideos.length * CARD_MIN + (seriesVideos.length - 1) * 16;
const staticCss = `@container pv-series (min-width: ${fitWidth}px) {
  .official-embeds.pv-series .pv-reel { overflow: visible; margin-inline: 0; -webkit-mask-image: none; mask-image: none; }
  .official-embeds.pv-series .pv-reel-track { width: auto; padding-inline: 0; }
  .official-embeds.pv-series [data-reel-set="0"], .official-embeds.pv-series .pv-repeat, .official-embeds.pv-series .pv-reel-controls { display: none; }
  .official-embeds.pv-series [data-reel-set="1"] { display: grid; grid-template-columns: repeat(${seriesVideos.length}, minmax(0, 1fr)); width: 100%; }
  .official-embeds.pv-series .pv-card { width: auto; max-width: none; }
}`;

// 期ごとの公式サイト。同じ URL は1つにまとめて名前をつなげる。期のサイトが1つも無ければ作品の公式サイトを出す
const seriesSites: { url: string; labels: string[] }[] = [];
for (const entry of series) {
  if (!entry.officialSite) continue;
  const same = seriesSites.find((link) => link.url === entry.officialSite);
  if (same) same.labels.push(entry.label);
  else seriesSites.push({ url: entry.officialSite, labels: [entry.label] });
}
if (!seriesSites.length && officialSite) seriesSites.push({ url: officialSite, labels: [site?.title ?? `${title} 公式サイト`] });
---

{isSeries && (
  <section class="official-embeds pv-series mb-10" aria-labelledby="official-heading">
    <Fragment set:html={`<style>${staticCss}</style>`} />
    <div class="flex items-center justify-between gap-4 mb-3">
      <h2 id="official-heading" class="text-sm font-semibold text-gray-400">公式の映像</h2>
      <div class="pv-reel-controls flex items-center gap-2 shrink-0">
        <button type="button" class="pv-reel-step glass rounded-full w-8 h-8 hidden sm:flex items-center justify-center text-gray-400 hover:text-cyan-400 transition-colors" data-step="-1" aria-label="前の映像へ">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
        </button>
        <button type="button" class="pv-reel-toggle glass rounded-full w-8 h-8 flex items-center justify-center text-gray-400 hover:text-cyan-400 transition-colors" aria-label="流れを止める">
          <svg class="reel-icon-pause w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3v14H7zM14 5h3v14h-3z" /></svg>
          <svg class="reel-icon-play w-4 h-4 hidden" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
        </button>
        <button type="button" class="pv-reel-step glass rounded-full w-8 h-8 hidden sm:flex items-center justify-center text-gray-400 hover:text-cyan-400 transition-colors" data-step="1" aria-label="次の映像へ">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    </div>
    <!-- 押した PV を出す場所。帯の中で再生すると流れて見えなくなるので、帯の上に出し、再生中は帯を止める -->
    <div class="pv-stage mb-2" hidden>
      <div class="pv-stage-frame relative aspect-video overflow-hidden rounded-2xl bg-black"></div>
      <div class="mt-2 flex items-start justify-between gap-3">
        <p class="pv-stage-caption text-sm text-gray-300 leading-snug"></p>
        <button type="button" class="pv-stage-close glass shrink-0 rounded-full px-3 py-1 text-xs text-gray-300 hover:text-cyan-400 transition-colors">閉じる</button>
      </div>
    </div>
    <div class="pv-reel -mx-6 overflow-x-auto" data-pv-reel role="region" aria-label="公式の映像（横にスクロールできます）">
      <div class="pv-reel-track flex w-max gap-4 px-6">
        {[0, 1].map((copy) => (
          <div class="flex gap-4" data-reel-set={copy} aria-hidden={copy === 0 ? 'true' : undefined}>
            {round.map(({ entry, first }) => {
              const pv = entry.youtube!;
              const reachable = copy === 1 && first;
              return (
                <div class:list={['pv-card w-[70vw] max-w-[300px] sm:w-[280px] shrink-0', { 'pv-repeat': !first }]} aria-hidden={copy === 1 && !first ? 'true' : undefined}>
                  <button
                    type="button"
                    class="pv-play group block w-full text-left"
                    data-yt={pv.id}
                    data-caption={`${entry.label}：${pv.title}（${pv.channel}）`}
                    tabindex={reachable ? undefined : -1}
                    aria-label={`${title}（${entry.label}）の PV を再生（YouTube）`}
                  >
                    <span class="pv-thumb relative block aspect-video overflow-hidden rounded-xl bg-black">
                      <img
                        src={`https://i.ytimg.com/vi/${pv.id}/hqdefault.jpg`}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                      />
                      <span class="absolute inset-0 bg-linear-to-t from-black/50 to-transparent"></span>
                      <span class="yt-icon absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2" aria-hidden="true">
                        <svg viewBox="0 0 68 48" width="48" height="34"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.3.3 34 .3 34 .3s-21.3 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 12.9.1 24 .1 24s0 11.1 1.4 16.3a8.5 8.5 0 0 0 6 6C12.7 47.7 34 47.7 34 47.7s21.3 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35.1 67.9 24 67.9 24s0-11.1-1.4-16.3z" fill="#f00"/><path d="M45 24 27 14v20z" fill="#fff"/></svg>
                      </span>
                    </span>
                    <span class="mt-2 block text-sm text-gray-100 font-medium leading-snug">
                      {entry.label}<span class="ml-2 text-xs text-gray-400 font-normal">{entry.year}</span>
                    </span>
                    <span class="mt-0.5 block text-xs text-gray-400 leading-snug truncate">{pv.channel}</span>
                  </button>
                </div>
              );
            })}
          </div>
        ))}
      </div>
    </div>
    {seriesSites.length > 0 && (
      <>
        <h3 class="text-sm font-semibold text-gray-400 mt-4 mb-3">公式サイト</h3>
        <ul class="flex flex-wrap gap-2">
          {seriesSites.map((link) => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="site-chip group inline-flex items-center gap-1.5 rounded-full glass border border-violet-500/20 hover:border-violet-400/50 transition-colors px-3.5 py-1.5 text-sm text-gray-100"
                title={link.url}
              >
                {link.labels.join('・')}
                <svg viewBox="0 0 20 20" width="12" height="12" aria-hidden="true" class="text-violet-300 transition-transform group-hover:translate-x-0.5"><path d="M7 4h9v9M16 4 5 15" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </section>
)}

{!isSeries && (youtube || officialSite) && (
  <section class="official-embeds mb-10" aria-labelledby="official-heading">
    <h2 id="official-heading" class="text-sm font-semibold text-gray-400 mb-3">公式の映像・サイト</h2>
    <div class:list={['grid gap-4 items-start', { 'md:grid-cols-[3fr_2fr]': youtube && officialSite }]}>
      {youtube && (
        <div class="yt-lite relative aspect-video overflow-hidden rounded-2xl bg-black" data-yt={youtube.id}>
          <button type="button" class="yt-play group absolute inset-0 w-full h-full" aria-label={`${title}の PV を再生（YouTube）`}>
            <img
              src={`https://i.ytimg.com/vi/${youtube.id}/hqdefault.jpg`}
              alt=""
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            />
            <span class="absolute inset-0 bg-linear-to-t from-black/70 via-black/10 to-transparent"></span>
            <span class="yt-icon absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2" aria-hidden="true">
              <svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.3.3 34 .3 34 .3s-21.3 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 12.9.1 24 .1 24s0 11.1 1.4 16.3a8.5 8.5 0 0 0 6 6C12.7 47.7 34 47.7 34 47.7s21.3 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35.1 67.9 24 67.9 24s0-11.1-1.4-16.3z" fill="#f00"/><path d="M45 24 27 14v20z" fill="#fff"/></svg>
            </span>
            <span class="absolute left-4 right-4 bottom-3 text-left photo-meta text-xs truncate">{youtube.title}（{youtube.channel}）</span>
          </button>
        </div>
      )}
      {officialSite && (
        <a
          href={officialSite}
          target="_blank"
          rel="noopener noreferrer"
          class="site-card group block overflow-hidden rounded-2xl glass border border-violet-500/20 hover:border-violet-400/50 transition-colors"
        >
          {site?.image ? (
            <div class="aspect-[1.91/1] overflow-hidden bg-black/40">
              <img
                src={site.image}
                alt=""
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
          ) : (
            <div class="aspect-[1.91/1] flex items-center justify-center bg-linear-to-br from-violet-600/40 via-sky-500/25 to-cyan-400/30 px-6">
              <span class="photo-title text-lg font-bold text-center">{title}</span>
            </div>
          )}
          <div class="p-4">
            <p class="text-sm text-gray-100 font-medium leading-snug line-clamp-2">{site?.title ?? `${title} 公式サイト`}</p>
            <p class="mt-1 text-xs text-violet-300 flex items-center gap-1">
              {host}
              <svg viewBox="0 0 20 20" width="12" height="12" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5"><path d="M7 4h9v9M16 4 5 15" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </p>
          </div>
        </a>
      )}
    </div>
  </section>
)}

<script>
  // YouTube：押したら iframe を読み込む。ClientRouter の遷移ではこのスクリプトが再実行されないので、遷移のたびに繋ぎ直す（同じ要素には二重に付けない）
  import { setupReel } from '../../lib/reel';

  function youtubeFrame(id: string): HTMLIFrameElement {
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
    iframe.title = 'YouTube';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    iframe.allowFullscreen = true;
    iframe.className = 'absolute inset-0 w-full h-full';
    return iframe;
  }

  function setupEmbeds(): void {
    // PV 1本の作品：サムネをその場で動画に差し替える
    document.querySelectorAll<HTMLElement>('.yt-lite').forEach((box) => {
      if (box.dataset.ytBound) return;
      box.dataset.ytBound = '1';
      box.querySelector('.yt-play')?.addEventListener('click', () => box.replaceChildren(youtubeFrame(box.dataset.yt!)));
    });

    // シリーズの作品：流れる帯。押した PV は帯の上で再生し、その間は帯を止める
    const reel = document.querySelector<HTMLElement>('[data-pv-reel]');
    const stage = document.querySelector<HTMLElement>('.pv-stage');
    if (!reel || !stage) return;
    const controls = setupReel(reel, {
      toggle: document.querySelector<HTMLButtonElement>('.pv-reel-toggle'),
      steps: document.querySelectorAll<HTMLButtonElement>('.pv-reel-step'),
      card: '.pv-card',
    });
    if (!controls) return;
    // 全部が横に収まって並べるだけのとき（CSS のコンテナクエリで1周目を消している）と、再生している間は流さない
    const firstSet = reel.querySelector<HTMLElement>('[data-reel-set="0"]')!;
    const isStill = () => getComputedStyle(firstSet).display === 'none';
    const update = () => {
      controls.hold(isStill() || !stage.hidden);
      reel.setAttribute('aria-label', isStill() ? '公式の映像' : '公式の映像（横にスクロールできます）');
    };
    new ResizeObserver(update).observe(reel);
    const frame = stage.querySelector<HTMLElement>('.pv-stage-frame')!;
    const caption = stage.querySelector<HTMLElement>('.pv-stage-caption')!;
    const markCurrent = (id: string | null) =>
      reel.querySelectorAll<HTMLElement>('.pv-play').forEach((button) => button.toggleAttribute('data-current', button.dataset.yt === id));

    reel.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLElement>('.pv-play');
      if (!button) return;
      frame.replaceChildren(youtubeFrame(button.dataset.yt!));
      caption.textContent = button.dataset.caption ?? '';
      stage.hidden = false;
      update();
      markCurrent(button.dataset.yt!);
      stage.scrollIntoView({ block: 'nearest' });
    });
    stage.querySelector('.pv-stage-close')?.addEventListener('click', () => {
      frame.replaceChildren();
      stage.hidden = true;
      update();
      markCurrent(null);
    });
  }

  document.addEventListener('astro:page-load', setupEmbeds);
</script>

<style>
  .yt-icon svg {
    filter: drop-shadow(0 4px 12px rgb(0 0 0 / 0.5));
    transition: transform 200ms ease-out;
  }
  .yt-play:hover .yt-icon svg,
  .yt-play:focus-visible .yt-icon svg,
  .pv-play:hover .yt-icon svg,
  .pv-play:focus-visible .yt-icon svg {
    transform: scale(1.08);
  }
  .yt-play:focus-visible,
  .pv-play:focus-visible .pv-thumb,
  .site-card:focus-visible,
  .site-chip:focus-visible {
    outline: 2px solid rgb(196 181 253);
    outline-offset: 2px;
  }
  .pv-play:focus-visible {
    outline: none;
  }
  /* 収まるかどうかを、この欄の幅で決める（上の staticCss のコンテナクエリ） */
  .official-embeds.pv-series {
    container: pv-series / inline-size;
  }
  /* PV の帯。トップの旅の帯と同じく、左右の端を淡くして続きがあることを見せ、スクロールバーは出さない */
  .pv-reel {
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 24px, #000 calc(100% - 24px), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 24px, #000 calc(100% - 24px), transparent 100%);
    scrollbar-width: none;
    scroll-behavior: auto; /* global.css の smooth が効くと毎フレームの位置合わせで流れない */
  }
  .pv-reel::-webkit-scrollbar {
    display: none;
  }
  .pv-reel-track {
    padding-top: 0.75rem;
    padding-bottom: 1rem;
  }
  .pv-card {
    transition: transform 300ms ease-out;
  }
  .pv-card[data-mouse-hover] {
    transform: translateY(-6px);
  }
  /* 再生中の PV（帯の上に出している PV） */
  .pv-play[data-current] .pv-thumb {
    outline: 2px solid rgb(34 211 238);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .yt-icon svg,
    .pv-card {
      transition: none;
    }
  }
</style>
