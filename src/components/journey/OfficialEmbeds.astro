---
// OfficialEmbeds.astro - 聖地巡礼の作品のページに、公式の PV（YouTube）と公式サイトのカードを置く。
// キャラクターの絵は権利者のものとして表示する（画像をこちらに置かない）。公式サイトの画像は無断利用を禁じている作品があるため。
// YouTube は最初はサムネだけを出し、押したら動画を読み込む（ページを重くしない。youtube-nocookie）。
// 公式サイトのカードの画像は、サイトがリンク共有用に出している og:image を公式サイトから直接出す（SNS のリンクカードと同じ）。
// 公式 X の埋め込みはやめた（ログイン状態やブラウザの追跡防止で出ないことが多く、更新の止まったアカウントもあった）。
import type { WorkLinks } from '../../lib/journey';

interface Props {
  title: string;
  links: WorkLinks;
}

const { title, links } = Astro.props;
const { youtube, officialSite, site } = links;
const host = officialSite ? new URL(officialSite).host.replace(/^www\./, '') : '';
---

{(youtube || officialSite) && (
  <section class="official-embeds mb-10" aria-labelledby="official-heading">
    <h2 id="official-heading" class="text-sm font-semibold text-gray-400 mb-3">公式の映像・サイト</h2>
    <div class:list={['grid gap-4 items-start', { 'md:grid-cols-[3fr_2fr]': youtube && officialSite }]}>
      {youtube && (
        <div class="yt-lite relative aspect-video overflow-hidden rounded-2xl bg-black" data-yt={youtube.id}>
          <button type="button" class="yt-play group absolute inset-0 w-full h-full" aria-label={`${title}の PV を再生（YouTube）`}>
            <img
              src={`https://i.ytimg.com/vi/${youtube.id}/hqdefault.jpg`}
              alt=""
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            />
            <span class="absolute inset-0 bg-linear-to-t from-black/70 via-black/10 to-transparent"></span>
            <span class="yt-icon absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2" aria-hidden="true">
              <svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.3.3 34 .3 34 .3s-21.3 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 12.9.1 24 .1 24s0 11.1 1.4 16.3a8.5 8.5 0 0 0 6 6C12.7 47.7 34 47.7 34 47.7s21.3 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35.1 67.9 24 67.9 24s0-11.1-1.4-16.3z" fill="#f00"/><path d="M45 24 27 14v20z" fill="#fff"/></svg>
            </span>
            <span class="absolute left-4 right-4 bottom-3 text-left photo-meta text-xs truncate">{youtube.title}（{youtube.channel}）</span>
          </button>
        </div>
      )}
      {officialSite && (
        <a
          href={officialSite}
          target="_blank"
          rel="noopener noreferrer"
          class="site-card group block overflow-hidden rounded-2xl glass border border-violet-500/20 hover:border-violet-400/50 transition-colors"
        >
          {site?.image ? (
            <div class="aspect-[1.91/1] overflow-hidden bg-black/40">
              <img
                src={site.image}
                alt=""
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
          ) : (
            <div class="aspect-[1.91/1] flex items-center justify-center bg-linear-to-br from-violet-600/40 via-sky-500/25 to-cyan-400/30 px-6">
              <span class="photo-title text-lg font-bold text-center">{title}</span>
            </div>
          )}
          <div class="p-4">
            <p class="text-sm text-gray-100 font-medium leading-snug line-clamp-2">{site?.title ?? `${title} 公式サイト`}</p>
            <p class="mt-1 text-xs text-violet-300 flex items-center gap-1">
              {host}
              <svg viewBox="0 0 20 20" width="12" height="12" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5"><path d="M7 4h9v9M16 4 5 15" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </p>
          </div>
        </a>
      )}
    </div>
  </section>
)}

<script>
  // YouTube：押したら iframe に差し替える
  document.querySelectorAll<HTMLElement>('.yt-lite').forEach((box) => {
    box.querySelector('.yt-play')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = 'YouTube';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 w-full h-full';
      box.replaceChildren(iframe);
    });
  });
</script>

<style>
  .yt-icon svg {
    filter: drop-shadow(0 4px 12px rgb(0 0 0 / 0.5));
    transition: transform 200ms ease-out;
  }
  .yt-play:hover .yt-icon svg,
  .yt-play:focus-visible .yt-icon svg {
    transform: scale(1.08);
  }
  .yt-play:focus-visible,
  .site-card:focus-visible {
    outline: 2px solid rgb(196 181 253);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .yt-icon svg {
      transition: none;
    }
  }
</style>
