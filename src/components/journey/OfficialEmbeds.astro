---
// OfficialEmbeds.astro - 聖地巡礼の作品のページに、公式の PV（YouTube）と公式 X の投稿を埋め込む。
// キャラクターの絵は権利者の投稿として表示する（画像をこちらに置かない）。公式サイトの画像は無断利用を禁じている作品があるため。
// YouTube は最初はサムネだけを出し、押したら動画を読み込む（ページを重くしない。youtube-nocookie）。
// X の投稿は画面に入ったときに公式の埋め込み（widgets.js）を読み込む。読み込めなくても投稿へのリンクは残る。
import type { WorkLinks } from '../../lib/journey';

interface Props {
  title: string;
  links: WorkLinks;
}

const { title, links } = Astro.props;
const { youtube, x, officialSite } = links;
---

{(youtube || x?.post) && (
  <section class="official-embeds mb-10" aria-labelledby="official-heading">
    <div class="flex flex-wrap items-baseline justify-between gap-2 mb-3">
      <h2 id="official-heading" class="text-sm font-semibold text-gray-400">公式の映像・投稿</h2>
      <div class="flex flex-wrap gap-3 text-xs">
        {officialSite && (
          <a href={officialSite} target="_blank" rel="noopener noreferrer" class="text-violet-300 hover:text-violet-200 underline-offset-4 hover:underline">
            公式サイト
          </a>
        )}
        {x?.handle && (
          <a href={`https://x.com/${x.handle}`} target="_blank" rel="noopener noreferrer" class="text-violet-300 hover:text-violet-200 underline-offset-4 hover:underline">
            公式X（@{x.handle}）
          </a>
        )}
      </div>
    </div>
    <!-- X の投稿は縦に長い（本文＋キービジュアル）ので、PV を幅いっぱいに置き、投稿はその下の中央に置く -->
    <div class="flex flex-col gap-4">
      {youtube && (
        <div class="yt-lite relative aspect-video overflow-hidden rounded-2xl bg-black" data-yt={youtube.id}>
          <button type="button" class="yt-play group absolute inset-0 w-full h-full" aria-label={`${title}の PV を再生（YouTube）`}>
            <img
              src={`https://i.ytimg.com/vi/${youtube.id}/hqdefault.jpg`}
              alt=""
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            />
            <span class="absolute inset-0 bg-linear-to-t from-black/70 via-black/10 to-transparent"></span>
            <span class="yt-icon absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2" aria-hidden="true">
              <svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.3.3 34 .3 34 .3s-21.3 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 12.9.1 24 .1 24s0 11.1 1.4 16.3a8.5 8.5 0 0 0 6 6C12.7 47.7 34 47.7 34 47.7s21.3 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35.1 67.9 24 67.9 24s0-11.1-1.4-16.3z" fill="#f00"/><path d="M45 24 27 14v20z" fill="#fff"/></svg>
            </span>
            <span class="absolute left-4 right-4 bottom-3 text-left photo-meta text-xs truncate">{youtube.title}（{youtube.channel}）</span>
          </button>
        </div>
      )}
      {x?.post && (
        <div class="x-embed w-full max-w-[560px] mx-auto min-h-[12rem] rounded-2xl glass p-2 overflow-hidden">
          <blockquote class="twitter-tweet" data-dnt="true" data-theme="dark" data-conversation="none">
            <a href={x.post.replace('x.com', 'twitter.com')}>公式Xの投稿を見る（@{x.handle}）</a>
          </blockquote>
        </div>
      )}
    </div>
  </section>
)}

<script>
  // YouTube：押したら iframe に差し替える
  document.querySelectorAll<HTMLElement>('.yt-lite').forEach((box) => {
    box.querySelector('.yt-play')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = 'YouTube';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 w-full h-full';
      box.replaceChildren(iframe);
    });
  });
  // X：投稿が画面に近づいたら widgets.js を一度だけ読み込む
  const tweets = document.querySelectorAll('.x-embed');
  if (tweets.length) {
    const load = () => {
      if (document.getElementById('x-widgets')) return;
      const script = document.createElement('script');
      script.id = 'x-widgets';
      script.async = true;
      script.src = 'https://platform.twitter.com/widgets.js';
      document.body.appendChild(script);
    };
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        load();
        observer.disconnect();
      }
    }, { rootMargin: '400px' });
    tweets.forEach((tweet) => observer.observe(tweet));
  }
</script>

<style>
  .yt-icon svg {
    filter: drop-shadow(0 4px 12px rgb(0 0 0 / 0.5));
    transition: transform 200ms ease-out;
  }
  .yt-play:hover .yt-icon svg,
  .yt-play:focus-visible .yt-icon svg {
    transform: scale(1.08);
  }
  .yt-play:focus-visible {
    outline: 2px solid rgb(196 181 253);
    outline-offset: -2px;
  }
  .x-embed :global(.twitter-tweet) {
    margin: 0 auto !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .yt-icon svg {
      transition: none;
    }
  }
</style>
