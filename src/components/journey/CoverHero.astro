---
// CoverHero.astro - 旅・聖地巡礼の作品のページの見出し。背景の画像（coverFor・workCoverFor）を形を崩さず全体を見せ、
// 文字（slot）を下の中央に重ねる。画像の出典があれば右下に小さく出す。
import type { TripCover } from '../../lib/journey';

interface Props {
  cover: TripCover | null;
  /** 画像の出典の表示 */
  credit?: string;
  /** 出典のページ（あればクレジットをリンクにする） */
  creditUrl?: string;
  /** 押すと背景の画像だけを大きく出す（旅のページ。本人の画像は文字が重なって見えないため。本人の指示） */
  zoomable?: boolean;
  class?: string;
}

const { cover, credit, creditUrl, zoomable = false, class: className } = Astro.props;
const zoom = zoomable && cover?.own && cover.srcset ? cover : null;
---

<!-- 画像は形を崩さず全体を見せる。本人の画像は、画像と同じ形の枠（hero-media）に画像をぴったり入れ、帯の中央に置く。
     左右の余白には画像を鏡に映して並べ、継ぎ目から離れるほどぼかして暗くする（hero-side）。いちばん下には、
     端を鏡に映して延ばした余白用の画像を枠の 250% で重ねて強くぼかし、上下の端まで覆う。スマホは 4:3 -->
<div
  class:list={[
    'trip-hero relative overflow-hidden rounded-2xl aspect-[4/3] md:aspect-auto md:h-[30rem]',
    className,
    { 'is-wide': cover?.shape === 'wide' },
  ]}
  style={cover?.ratio ? `--r: ${cover.ratio}` : undefined}
>
  {cover && cover.fill ? (
    <div class="hero-media">
      <img src={cover.fill} alt="" aria-hidden="true" decoding="async" class="hero-fill hero-fill-strong" />
      <img src={cover.fill} alt="" aria-hidden="true" decoding="async" class="hero-fill hero-fill-soft" />
      {['l', 'r'].map((side) => (
        <div class={`hero-side hero-side-${side}`} aria-hidden="true">
          {['far', 'mid', 'near'].map((depth) => (
            <img
              src={cover.src}
              srcset={cover.srcset}
              sizes="(min-width: 768px) 860px, 100vw"
              alt=""
              decoding="async"
              class={`hero-mirror is-${depth}`}
            />
          ))}
        </div>
      ))}
      <img
        src={cover.src}
        srcset={cover.srcset}
        sizes="(min-width: 768px) 860px, 100vw"
        alt=""
        decoding="async"
        fetchpriority="high"
        class="hero-img"
      />
    </div>
  ) : cover ? (
    <>
      <img
        src={cover.src}
        alt=""
        aria-hidden="true"
        decoding="async"
        class="cover-backdrop absolute inset-0 w-full h-full object-cover"
      />
      <img
        src={cover.src}
        alt=""
        decoding="async"
        fetchpriority="high"
        class="cover-fade absolute top-0 left-1/2 -translate-x-1/2 h-full w-auto max-w-none"
      />
    </>
  ) : null}
  <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent"></div>
  {zoom && (
    <button type="button" class="hero-zoom" data-hero-zoom aria-label="背景の画像を大きく見る" aria-haspopup="dialog">
      <span class="hero-zoom-hint" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
      </span>
    </button>
  )}
  <!-- 押せるときは、文字の上を押しても画像のボタンに届くようにする（文字の中に押せるものは無い） -->
  <div class:list={['relative h-full flex flex-col justify-end items-center text-center p-6', { 'pointer-events-none': zoom }]}>
    <slot />
  </div>
  <!-- 画像だけを元の形のまま、画面に収まる大きさ（いちばん大きくて 1600px）で出す。どこを押しても・Esc でも閉じる -->
  {zoom && (
    <dialog class="hero-lightbox" aria-label="背景の画像">
      <img src={zoom.src} srcset={zoom.srcset} sizes="min(1600px, 100vw)" alt="" loading="lazy" decoding="async" class="hero-lightbox-img" />
      <button type="button" class="hero-lightbox-close" aria-label="閉じる">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </dialog>
  )}
  {credit && (
    <p class="hero-credit">
      {creditUrl ? <a href={creditUrl} target="_blank" rel="noopener noreferrer">{credit}</a> : credit}
    </p>
  )}
</div>

<script>
  // 背景の画像を大きく見る。ClientRouter の遷移ではこのスクリプトが再実行されないので、遷移のたびに繋ぐ（二重には付けない）
  function setupHeroZoom(): void {
    document.querySelectorAll<HTMLButtonElement>('[data-hero-zoom]').forEach((button) => {
      const dialog = button.parentElement?.querySelector<HTMLDialogElement>('.hero-lightbox');
      if (!dialog || button.dataset.bound) return;
      button.dataset.bound = '1';
      button.addEventListener('click', () => dialog.showModal());
      // 画像の上でも外でも、押したら閉じる（もう一度押すと戻る）
      dialog.addEventListener('click', () => dialog.close());
    });
  }

  document.addEventListener('astro:page-load', setupHeroZoom);
</script>

<style>
  .trip-hero {
    background: #0f172a;
  }
  /* 背景の画像を大きく見るボタン（見出し全体）。右上に小さく印を出す */
  .hero-zoom {
    position: absolute;
    inset: 0;
    cursor: zoom-in;
  }
  .hero-zoom:focus-visible {
    outline: 2px solid rgb(196 181 253);
    outline-offset: -4px;
    border-radius: 1rem;
  }
  .hero-zoom-hint {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    color: #fff;
    background: rgb(15 23 42 / 0.55);
    backdrop-filter: blur(6px);
    transition: transform 200ms ease-out, background-color 200ms ease-out;
  }
  .hero-zoom:hover .hero-zoom-hint,
  .hero-zoom:focus-visible .hero-zoom-hint {
    transform: scale(1.1);
    background: rgb(15 23 42 / 0.75);
  }
  .hero-lightbox {
    margin: auto; /* Tailwind の初期化が margin を 0 にして、左上に寄っていた */
    padding: 0;
    border: 0;
    background: transparent;
    max-width: none;
    max-height: none;
    overflow: visible;
    cursor: zoom-out;
  }
  .hero-lightbox::backdrop {
    background: rgb(2 6 23 / 0.88);
    backdrop-filter: blur(4px);
  }
  .hero-lightbox-img {
    display: block;
    width: auto;
    height: auto;
    max-width: min(1600px, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    border-radius: 0.75rem;
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.5);
  }
  .hero-lightbox-close {
    position: fixed;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    color: #fff;
    background: rgb(15 23 42 / 0.7);
  }
  .hero-lightbox[open] {
    animation: hero-lightbox-in 200ms ease-out;
  }
  @keyframes hero-lightbox-in {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }
  /* 開いている間は後ろのページを動かさない */
  :global(html:has(.hero-lightbox[open])) {
    overflow: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-zoom-hint {
      transition: none;
    }
    .hero-lightbox[open] {
      animation: none;
    }
  }
  /* 題名は単語の区切り（<wbr>）でだけ折り返す。どうしても入らない長い塊だけは途中で折る */
  .trip-hero :global(.hero-title) {
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  /* 画像の出典（作品の背景画像）。右下に小さく出す */
  .hero-credit {
    position: absolute;
    right: 0.75rem;
    bottom: 0.5rem;
    max-width: 60%;
    font-size: 10px;
    line-height: 1.4;
    text-align: right;
    color: rgb(255 255 255 / 0.65);
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.8);
  }
  .hero-credit a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* 投稿のサムネで代えた旅（余白用の画像が無い）。同じ画像を広げて強くぼかす */
  .trip-hero .cover-backdrop {
    filter: blur(28px) brightness(0.8);
    transform: scale(1.15);
  }

  /* 本人の画像。枠（hero-media）は画像と同じ形（--r は幅÷高さ）。ふだんは高さに合わせて中央に置く */
  .hero-media {
    position: absolute;
    top: 0;
    left: 50%;
    height: 100%;
    aspect-ratio: var(--r);
    transform: translateX(-50%);
  }
  /* スマホの帯（4:3）に横長の画像：幅に合わせて上下を空ける（高さに合わせると左右が切れて、端の文字が欠けた） */
  .trip-hero.is-wide .hero-media {
    top: 50%;
    left: 0;
    width: 100%;
    height: auto;
    transform: translateY(-50%);
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* 画像の端はわずかに透かすだけにする（16% 透かしたら、端の文字がぼけて読めなくなった） */
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 3%, #000 97%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 3%, #000 97%, transparent 100%);
  }
  .trip-hero.is-wide .hero-img {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 3%, #000 97%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 3%, #000 97%, transparent 100%);
  }
  /* 余白用の画像（上下左右に 0.75 倍ずつ延ばしてある）を枠の 250% で中央に重ねる。手前の画像は余白用の画像の 30%〜70% に当たる */
  .hero-fill {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 250%;
    height: 250%;
    max-width: none;
    transform: translate(-50%, -50%);
  }
  .hero-fill-strong {
    filter: blur(28px) brightness(0.8);
  }
  /* スマホの横長の上下の余白。画像のすぐ外は弱いぼかしにし、離れるにつれて強いぼかし（下の層）へ移る */
  .hero-fill-soft {
    filter: blur(6px) brightness(0.85);
    -webkit-mask-image:
      linear-gradient(to right, transparent 21%, #000 29.5%, #000 70.5%, transparent 79%),
      linear-gradient(to bottom, transparent 21%, #000 29.5%, #000 70.5%, transparent 79%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 21%, #000 29.5%, #000 70.5%, transparent 79%),
      linear-gradient(to bottom, transparent 21%, #000 29.5%, #000 70.5%, transparent 79%);
    mask-composite: intersect;
  }

  @media (min-width: 768px) {
    /* PC の帯は画像より横長なので、横長の画像も高さに合わせて中央に置く */
    .trip-hero.is-wide .hero-media {
      top: 0;
      left: 50%;
      width: auto;
      height: 100%;
      transform: translateX(-50%);
    }
    .trip-hero.is-wide .hero-img {
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 3%, #000 97%, transparent 100%);
      mask-image: linear-gradient(to right, transparent 0, #000 3%, #000 97%, transparent 100%);
    }
    .trip-hero.is-wide .hero-fill-soft {
      display: none;
    }
  }

  /* 左右の余白：画像を鏡に映して並べる（本人が、鏡・端の色を横に延ばす・色のにじみに浮かべる の3案から選んだ）。
     弱いぼかしの層（hero-fill-soft）は、スマホの横長の上下の余白にだけ使う（PC の横長は上の @media で消す） */
  .trip-hero:not(.is-wide) .hero-fill-soft {
    display: none;
  }
  .hero-side {
    position: absolute;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  /* --dir は継ぎ目から外への向き。鏡の画像は裏返してあるので、画像に掛ける透かしは逆の向き（--mdir）で書く
     （同じ向きで書いたら、くっきりした部分が継ぎ目でなく外側に出た） */
  .hero-side-l {
    right: 100%;
    --dir: to left;
    --mdir: to right;
  }
  .hero-side-r {
    left: 100%;
    --dir: to right;
    --mdir: to left;
  }
  .hero-mirror {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    transform: scaleX(-1);
  }
  /* 継ぎ目のすぐ外はくっきり（1.5px）、60〜180px で 6px、その先は 18px のぼかしへ移る。
     遠くの層はぼかしで上下の端が透けるので、上下に少しはみ出させる */
  .hero-mirror.is-far {
    top: -8%;
    height: 116%;
    filter: blur(18px) brightness(0.6);
  }
  .hero-mirror.is-mid {
    filter: blur(6px) brightness(0.7);
    -webkit-mask-image: linear-gradient(var(--mdir), #000 0, #000 60px, transparent 180px);
    mask-image: linear-gradient(var(--mdir), #000 0, #000 60px, transparent 180px);
  }
  /* 鏡の側は手前の画像より少し暗くし、どこまでが写真かを分かるようにする */
  .hero-mirror.is-near {
    filter: blur(1.5px) brightness(0.8);
    -webkit-mask-image: linear-gradient(var(--mdir), #000 0, #000 12px, transparent 64px);
    mask-image: linear-gradient(var(--mdir), #000 0, #000 12px, transparent 64px);
  }
  .hero-side::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(var(--dir), rgb(15 23 42 / 0) 0, rgb(15 23 42 / 0.55) 280px);
  }
</style>
