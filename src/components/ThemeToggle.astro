---
// ThemeToggle.astro - テーマ切り替えと時間表示コンポーネント
---

<div class="theme-menu flex items-center space-x-4">
  <!-- 現在時刻表示 -->
  <div class="current-time text-cyan-400 font-mono text-sm"></div>
  
  <!-- 日の出・日没時間表示 -->
  <div class="sun-times text-xs space-y-1">
    <div id="sunriseTime" class="text-orange-300 font-medium shadow-text">Sunrise: --:--</div>
    <div id="sunsetTime" class="text-purple-400 font-medium shadow-text">Sunset: --:--</div>
  </div>
  
  <!-- テーマ切り替えボタン -->
  <div class="relative">
    <button id="themeToggleBtn" class="p-2 rounded-lg glass hover:bg-white/10 transition-all duration-300" title="テーマ切り替え">
      <!-- 太陽アイコン（ライトモード用） -->
      <svg id="sunIcon" class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd" />
      </svg>
      <!-- 月アイコン（ダークモード用） -->
      <svg id="moonIcon" class="w-5 h-5 text-blue-300 hidden" fill="currentColor" viewBox="0 0 20 20">
        <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
      </svg>
    </button>
    
    <!-- テーマドロップダウンメニュー -->
    <div class="theme-dropdown absolute right-0 top-full mt-2 w-48 glass rounded-lg shadow-lg hidden z-50">
      <button data-theme="light" class="w-full px-4 py-2 text-left text-gray-300 hover:text-cyan-400 hover:bg-white/10 rounded-t-lg transition-colors">
        ☀️ ライトモード
      </button>
      <button data-theme="dark" class="w-full px-4 py-2 text-left text-gray-300 hover:text-cyan-400 hover:bg-white/10 transition-colors">
        🌙 ダークモード
      </button>
      <button data-theme="auto" class="w-full px-4 py-2 text-left text-gray-300 hover:text-cyan-400 hover:bg-white/10 rounded-b-lg transition-colors">
        🌅 自動（日没に合わせる）
      </button>
    </div>
  </div>
</div>

<script>
  // 日の出・日没API設定
  const LATITUDE = 35.6762; // 東京の緯度
  const LONGITUDE = 139.6503; // 東京の経度

  // ローカルストレージのキー
  const SUNRISE_SUNSET_CACHE_KEY = 'sunrise-sunset-cache';
  const THEME_PREFERENCE_KEY = 'theme-preference';

  type ThemePreference = 'light' | 'dark' | 'auto';

  // JSTの今日の日付を YYYY/M/D 形式で返す
  function getTodayJST(): string {
    return new Date().toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo' });
  }

  // JSTの今日を YYYY-MM-DD で返す（APIに渡す用）
  function getTodayJSTForApi(): string {
    return new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Tokyo' });
  }

  // 日の出・日没APIのURL。
  // **日付を明示するのが要点。** 省略すると API は現在のUTC日付で答えるため、
  // JST 00:00〜09:00 のアクセスでは前日の値が返る。それを「JSTの今日」として
  // 保存すると、その日は一日中「日没を過ぎている」と判定されてナイトモードから
  // 戻らなくなる。
  function sunApiUrl(): string {
    return `https://api.sunrise-sunset.org/json?lat=${LATITUDE}&lng=${LONGITUDE}&formatted=0&date=${getTodayJSTForApi()}`;
  }

  // 保存されたテーマの選択を読む。未設定は自動。
  function getThemePreference(): ThemePreference {
    try {
      const saved = localStorage.getItem(THEME_PREFERENCE_KEY);
      return saved === 'light' || saved === 'dark' ? saved : 'auto';
    } catch {
      return 'auto';
    }
  }

  function saveThemePreference(preference: ThemePreference): void {
    try {
      if (preference === 'auto') {
        localStorage.removeItem(THEME_PREFERENCE_KEY);
      } else {
        localStorage.setItem(THEME_PREFERENCE_KEY, preference);
      }
    } catch {
      // プライベートブラウジング等で書けなくても動作は続ける
    }
  }

  // 時刻のフォーマット関数
  function formatTime(date: Date): string {
    return date.toLocaleTimeString('ja-JP', {
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'Asia/Tokyo'
    });
  }

  // 現在時刻を更新する関数
  function updateCurrentTime(): void {
    const now = new Date();
    const timeElement = document.querySelector('.current-time');
    if (timeElement) {
      timeElement.textContent = now.toLocaleTimeString('ja-JP', {
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        timeZone: 'Asia/Tokyo'
      });
    }
  }

  // キャッシュから日の出・日没データを取得
  function getCachedSunriseSunset(): { sunrise: string; sunset: string; date: string } | null {
    try {
      const cached = localStorage.getItem(SUNRISE_SUNSET_CACHE_KEY);
      if (!cached) return null;

      const data = JSON.parse(cached);

      // JSTの今日の日付と一致しない場合は無効（日付をまたぐと時刻がずれるため）
      if (data.date !== getTodayJST()) {
        localStorage.removeItem(SUNRISE_SUNSET_CACHE_KEY);
        return null;
      }

      // 中身が保存日と合っているかも確かめる。
      // 以前は日付を指定せずにAPIを呼んでいたため、JST 00:00〜09:00 のアクセスでは
      // 前日の日の出・日没が「今日」として保存されていた。その状態だと一日中
      // 日没を過ぎた判定になる。ここで捨てれば、既に壊れている端末もすぐ直る。
      const asJSTDate = (iso: string) =>
        new Date(iso).toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo' });
      if (asJSTDate(data.sunrise) !== data.date || asJSTDate(data.sunset) !== data.date) {
        localStorage.removeItem(SUNRISE_SUNSET_CACHE_KEY);
        return null;
      }

      return data;
    } catch (error) {
      console.error('キャッシュ読み込みエラー:', error);
      return null;
    }
  }

  // 日の出・日没データをキャッシュに保存
  function cacheSunriseSunset(sunrise: string, sunset: string): void {
    try {
      localStorage.setItem(SUNRISE_SUNSET_CACHE_KEY, JSON.stringify({
        sunrise,
        sunset,
        date: getTodayJST(),
      }));
    } catch (error) {
      console.error('キャッシュ保存エラー:', error);
    }
  }

  // 日の出・日没時間を取得して表示する関数（テーマ適用なし）
  async function updateSunTimes(): Promise<void> {
    try {
      let sunriseUTC: Date;
      let sunsetUTC: Date;

      // まずキャッシュを確認
      const cached = getCachedSunriseSunset();

      if (cached) {
        // キャッシュがある場合、それを使用
        sunriseUTC = new Date(cached.sunrise);
        sunsetUTC = new Date(cached.sunset);
        console.log('キャッシュから日の出・日没時間を取得しました');
      } else {
        // キャッシュがない場合、APIから取得
        const response = await fetch(sunApiUrl());

        if (!response.ok) {
          throw new Error(`APIリクエストに失敗しました: ${response.status}`);
        }

        const data = await response.json();

        if (data.status !== 'OK') {
          throw new Error('APIからデータを取得できませんでした');
        }

        // 日の出・日没時間を取得 (UTC)
        sunriseUTC = new Date(data.results.sunrise);
        sunsetUTC = new Date(data.results.sunset);

        // キャッシュに保存
        cacheSunriseSunset(data.results.sunrise, data.results.sunset);
        console.log('APIから日の出・日没時間を取得してキャッシュしました');
      }

      // formatTime関数は既にJSTに変換してくれるので、そのまま使用
      const sunriseTime = formatTime(sunriseUTC);
      const sunsetTime = formatTime(sunsetUTC);

      // 日の出・日没時間を表示
      const sunriseElement = document.getElementById('sunriseTime');
      const sunsetElement = document.getElementById('sunsetTime');

      if (sunriseElement) sunriseElement.textContent = `Sunrise: ${sunriseTime}`;
      if (sunsetElement) sunsetElement.textContent = `Sunset: ${sunsetTime}`;

    } catch (error) {
      console.error('日の出・日没時間の取得エラー:', error);

      const sunriseElement = document.getElementById('sunriseTime');
      const sunsetElement = document.getElementById('sunsetTime');

      if (sunriseElement) sunriseElement.textContent = 'Sunrise: 未取得';
      if (sunsetElement) sunsetElement.textContent = 'Sunset: 未取得';
    }
  }

  // テーマ切り替え&日の出日没時間表示関数（自動モード用）
  //
  // 手動でライト/ダークを選んでいるときは、時刻表示だけ更新してテーマには触らない。
  // 以前はここが無条件に走っていたため、手動で選んでも1分後の定期実行で自動判定に
  // 戻されていた。
  async function setThemeBasedOnSunriseSunset(): Promise<void> {
    if (getThemePreference() !== 'auto') {
      await updateSunTimes();
      updateThemeIcon();
      return;
    }
    try {
      let sunriseUTC: Date;
      let sunsetUTC: Date;

      // まずキャッシュを確認
      const cached = getCachedSunriseSunset();

      if (cached) {
        // キャッシュがある場合、それを使用
        sunriseUTC = new Date(cached.sunrise);
        sunsetUTC = new Date(cached.sunset);
        console.log('キャッシュから日の出・日没時間を取得しました');
      } else {
        // キャッシュがない場合、APIから取得
        const response = await fetch(sunApiUrl());

        if (!response.ok) {
          throw new Error(`APIリクエストに失敗しました: ${response.status}`);
        }

        const data = await response.json();

        if (data.status !== 'OK') {
          throw new Error('APIからデータを取得できませんでした');
        }

        // 日の出・日没時間を取得 (UTC)
        sunriseUTC = new Date(data.results.sunrise);
        sunsetUTC = new Date(data.results.sunset);

        // キャッシュに保存
        cacheSunriseSunset(data.results.sunrise, data.results.sunset);
        console.log('APIから日の出・日没時間を取得してキャッシュしました');
      }

      // 現在時刻（UTC）で統一して比較
      const nowUTC = new Date();

      // formatTime関数は既にJSTに変換してくれるので、そのまま使用
      const sunriseTime = formatTime(sunriseUTC);
      const sunsetTime = formatTime(sunsetUTC);

      // 日の出・日没時間を表示（正しい順序で）
      const sunriseElement = document.getElementById('sunriseTime');
      const sunsetElement = document.getElementById('sunsetTime');

      if (sunriseElement) sunriseElement.textContent = `Sunrise: ${sunriseTime}`;
      if (sunsetElement) sunsetElement.textContent = `Sunset: ${sunsetTime}`;

      // テーマ切り替えロジック（UTCで統一して比較）
      // 日の出後から日没前の場合：ライトモード
      // 日没後または日の出前の場合：ナイトモード
      if (nowUTC >= sunriseUTC && nowUTC <= sunsetUTC) {
        document.body.classList.add('light-mode');
        document.body.classList.remove('night-mode');
        console.log('ライトモードに切り替え:', {
          now: nowUTC.toISOString(),
          sunrise: sunriseUTC.toISOString(),
          sunset: sunsetUTC.toISOString()
        });
      } else {
        document.body.classList.add('night-mode');
        document.body.classList.remove('light-mode');
        console.log('ナイトモードに切り替え:', {
          now: nowUTC.toISOString(),
          sunrise: sunriseUTC.toISOString(),
          sunset: sunsetUTC.toISOString()
        });
      }

      // アイコンを更新
      updateThemeIcon();

    } catch (error) {
      console.error('日の出・日没時間の取得エラー:', error);

      // エラー時のデフォルト動作
      const defaultSunsetHour = 18;
      const now = new Date().getHours();

      document.body.classList.toggle('night-mode', now >= defaultSunsetHour);
      document.body.classList.toggle('light-mode', now < defaultSunsetHour);

      // アイコンを更新
      updateThemeIcon();

      const sunriseElement = document.getElementById('sunriseTime');
      const sunsetElement = document.getElementById('sunsetTime');

      if (sunriseElement) sunriseElement.textContent = 'Sunrise: 未取得';
      if (sunsetElement) sunsetElement.textContent = 'Sunset: 未取得';
    }
  }

  // アイコンを更新する関数
  function updateThemeIcon(): void {
    const sunIcon = document.getElementById('sunIcon');
    const moonIcon = document.getElementById('moonIcon');

    if (sunIcon && moonIcon) {
      if (document.body.classList.contains('night-mode')) {
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
      } else {
        sunIcon.classList.remove('hidden');
        moonIcon.classList.add('hidden');
      }
    }
  }

  // 手動テーマ設定を適用する関数
  function applyManualTheme(theme: 'light' | 'dark'): void {
    if (theme === 'light') {
      document.body.classList.remove('night-mode');
      document.body.classList.add('light-mode');
    } else {
      document.body.classList.remove('light-mode');
      document.body.classList.add('night-mode');
    }
    updateThemeIcon();
  }

  // 初期テーマを設定する関数（即座に実行）
  //
  // 保存された選択があればそれを使う。ページをまたいでも、リロードしても引き継がれる。
  // 以前は保存自体をしておらず、毎回自動モードで始まっていた。
  function initializeTheme(): void {
    const preference = getThemePreference();
    if (preference !== 'auto') {
      applyManualTheme(preference);
      return;
    }

    // 自動モード。キャッシュまたはデフォルトでテーマを設定
    const cached = getCachedSunriseSunset();
    if (cached) {
      const nowUTC = new Date();
      const sunriseUTC = new Date(cached.sunrise);
      const sunsetUTC = new Date(cached.sunset);

      if (nowUTC >= sunriseUTC && nowUTC <= sunsetUTC) {
        applyManualTheme('light');
      } else {
        applyManualTheme('dark');
      }
    } else {
      // キャッシュもない場合、デフォルト（18時判定）
      const hour = new Date().getHours();
      applyManualTheme(hour < 18 ? 'light' : 'dark');
    }
  }

  // 初期テーマを即座に適用（フラッシュ防止）
  initializeTheme();

  // ViewTransitions のページ遷移では <body> の class が新しいページのものに
  // 差し替わり、実行時に付けた light-mode / night-mode が消える。スクリプトは
  // モジュールなので再実行されず、テーマが初期状態に戻ってしまう。
  // 描画前の after-swap で付け直す。
  document.addEventListener('astro:after-swap', initializeTheme);

  // グローバル関数として登録（Header.astroから呼び出せるように）
  (window as any).setThemeBasedOnSunriseSunset = setThemeBasedOnSunriseSunset;

  // テーマドロップダウンの結線。遷移で要素が入れ替わるため、毎回やり直す。
  // 同じ要素に二重で登録しないよう、済んだものには印を付ける。
  function bindThemeControls(): void {
  const themeToggleBtn = document.getElementById('themeToggleBtn');
  const themeDropdown = document.querySelector('.theme-dropdown');

  if (themeToggleBtn && themeDropdown && !themeToggleBtn.dataset.bound) {
    themeToggleBtn.dataset.bound = '1';
    themeToggleBtn.addEventListener('click', () => {
      themeDropdown.classList.toggle('hidden');
    });

    // 外部クリックでメニューを閉じる
    document.addEventListener('click', (e) => {
      if (!themeToggleBtn.contains(e.target as Node) && !themeDropdown.contains(e.target as Node)) {
        themeDropdown.classList.add('hidden');
      }
    });
  }

  // ドロップダウンメニューでテーマ選択
  document.querySelectorAll<HTMLButtonElement>('.theme-dropdown button').forEach(button => {
    if (button.dataset.bound) return;
    button.dataset.bound = '1';
    button.addEventListener('click', (event) => {
      const selectedTheme = (event.currentTarget as HTMLButtonElement).getAttribute('data-theme');

      if (selectedTheme === 'light' || selectedTheme === 'dark') {
        saveThemePreference(selectedTheme);
        applyManualTheme(selectedTheme);
      } else if (selectedTheme === 'auto') {
        saveThemePreference('auto');
        setThemeBasedOnSunriseSunset();
      }

      // メニューを閉じる
      if (themeDropdown) {
        themeDropdown.classList.add('hidden');
      }
    });
  });
  }

  // ページごとの初期化。遷移後は要素が差し替わっているので、そのつど繋ぎ直す。
  function setupPage(): void {
    bindThemeControls();
    updateCurrentTime();
    updateSunTimes();
    setThemeBasedOnSunriseSunset();
    updateThemeIcon();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPage, { once: true });
  } else {
    setupPage();
  }
  document.addEventListener('astro:page-load', setupPage);

  // 時計の更新は1度だけ仕掛ける（遷移のたびに増やさない）
  setInterval(updateCurrentTime, 1000);

  // 定期的に日の出・日没時間を更新（5分ごと - 全モード共通）
  setInterval(() => {
    updateSunTimes();
  }, 5 * 60 * 1000); // 5分ごと

  // 定期的にテーマを確認・変更（1分ごと）
  setInterval(() => {
    // テーマを自動適用
    setThemeBasedOnSunriseSunset();
  }, 60 * 1000); // 1分ごと
</script>