---
// JourneySection.astro - 旅の記録セクション
//
// 都道府県（8地方）・旅・聖地巡礼の3本立て。3つの軸は排他ではなく、
// 同じ投稿が県ページにも旅ページにも聖地巡礼ページにも出るのは仕様。
//
// 47都道府県のデータは data/journey/prefectures.json に移してある
// （以前はこのファイルにベタ書きしていた）。投稿との対応は
// scripts/journey/resolve.py が作る resolved.json が持つ。
import {
  regions,
  trips,
  works,
  workCount,
  themes,
  posts,
  postCountByPrefecture,
} from '../../lib/journey';
// 地方の形の透かし（scripts/journey/build_region_silhouettes.py が県境から作る）
import silhouettes from '../../lib/region-silhouettes.json';
import TripCard from '../journey/TripCard.astro';

const silhouetteByRegion: Record<string, { viewBox: string; d: string }> = silhouettes;

const allPrefectures = regions.flatMap((region) => region.prefectures);
const visitedCount = allPrefectures.filter((p) => p.visited).length;
const totalCount = allPrefectures.length;
const visitedRegionCount = regions.filter((r) => r.prefectures.some((p) => p.visited)).length;
const postCount = posts.length;
const tripPostCount = trips.reduce((sum, trip) => sum + trip.postCount, 0);
const workPostCount = works.reduce((sum, work) => sum + work.postCount, 0);
const themePostCount = themes.reduce((sum, theme) => sum + theme.postCount, 0);
// 新しい旅から3件。トップで旅の写真が見えるのはここだけ
const recentTrips = [...trips].sort((a, b) => b.start.localeCompare(a.start)).slice(0, 3);

---

<section id="journey" class="py-20 relative">
  <div class="container mx-auto px-6">
    <!-- セクションタイトル -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold gradient-text mb-4">Journey</h2>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto">
        日本各地を旅しながら出会った風景や自然を記録しています。<br>
        その土地にしかない空気感と光を求めて、今日も旅を続けています。
      </p>
    </div>

    <!-- 最近の旅。写真が目に入るように地方の一覧より先に置く。
         スマホで縦に3枚積むと長くなるので、横に流して1枚ずつ送る -->
    {recentTrips.length > 0 && (
      <div class="mb-12">
        <div class="flex items-baseline justify-between gap-4 mb-4">
          <h3 class="text-xl font-bold text-white">最近の旅</h3>
          <a href="/journey/trips/" class="shrink-0 text-sm text-gray-400 hover:text-cyan-400 transition-colors">
            すべての旅（{trips.length}件）→
          </a>
        </div>
        <div class="-mx-6 px-6 scroll-px-6 sm:mx-0 sm:px-0 flex sm:grid sm:grid-cols-3 gap-4 overflow-x-auto sm:overflow-visible snap-x snap-mandatory pt-1 pb-2 sm:p-0">
          {recentTrips.map((trip) => (
            <div class="w-[80%] shrink-0 snap-start sm:w-auto">
              <TripCard trip={trip} />
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- 8地方＋海外のグリッド -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      {regions.map((region) => {
        const regionVisited = region.prefectures.filter(p => p.visited).length;
        const silhouette = silhouetteByRegion[region.name];
        const [, , silW, silH] = silhouette ? silhouette.viewBox.split(' ').map(Number) : [0, 0, 1, 1];
        return (
          <div class="glass rounded-2xl overflow-hidden hover-lift">
            <!-- ヘッダー。global.css がライトモードで bg-gradient-to-* を一色に、text-white を黒に
                 塗り替えるので、それらを使わず昼も夜も地方ごとの色と白文字のままにする -->
            <div class={`relative overflow-hidden bg-linear-to-r ${region.gradient} px-5 py-4 flex items-center justify-between`}>
              {silhouette && (
                <svg
                  class="region-silhouette pointer-events-none absolute right-16 top-1/2 -translate-y-1/2 h-[118%]"
                  style={`aspect-ratio: ${silW} / ${silH}`}
                  viewBox={silhouette.viewBox}
                  aria-hidden="true"
                >
                  <path d={silhouette.d} />
                </svg>
              )}
              <div class="relative">
                <div class="text-slate-50 font-bold text-lg">{region.name}</div>
                <div class="text-slate-50/75 text-xs">{region.en}</div>
              </div>
              <div class="relative text-right">
                <div class="text-slate-50 font-semibold text-sm">{regionVisited} / {region.prefectures.length}</div>
                <div class="text-slate-50/75 text-xs">都道府県</div>
              </div>
            </div>

            <!-- 都道府県バッジ -->
            <div class="p-4">
              <div class="flex flex-wrap gap-2">
                {region.prefectures.map((pref) => {
                  const count = postCountByPrefecture[pref.code] ?? 0;
                  const Tag = pref.visited ? 'a' : 'div';
                  return (
                  <Tag
                    class="group/pref relative"
                    href={pref.visited ? `/journey/${pref.slug}/` : undefined}
                    title={pref.note ?? pref.name}
                  >
                    <span class={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium transition-all ${
                      pref.visited
                        ? 'bg-white/20 text-white border border-white/30 hover:bg-white/30'
                        : 'bg-white/5 text-gray-500 border border-white/10'
                    }`}>
                      {pref.shortName}
                      {count > 0 ? (
                        <span class="ml-1 text-white/60 text-[10px]">{count}</span>
                      ) : pref.visited ? (
                        <span class="ml-1 text-green-400 text-xs">✓</span>
                      ) : null}
                    </span>
                    {pref.note && (
                      <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-1 px-2 py-1 bg-gray-800 text-white text-xs rounded whitespace-nowrap opacity-0 group-hover/pref:opacity-100 transition-opacity pointer-events-none z-10">
                        {pref.note}
                      </div>
                    )}
                  </Tag>
                  );
                })}
              </div>
            </div>
          </div>
        );
      })}

      <!-- 9枠目は海外。投稿が出るまでは空のままリンクにしない。2列のときは1枚だけの行になるので横に広げる -->
      <!-- 宇宙から見た地球（右下から昇る）。背景は下の <style> の .overseas-earth -->
      <div
        class="overseas-earth rounded-2xl overflow-hidden flex flex-col md:col-span-2 xl:col-span-1 cursor-default border border-sky-300/30 shadow-[0_0_28px_rgba(56,189,248,0.18)]"
        aria-disabled="true"
      >
        <div class="px-5 py-4 flex items-center justify-between">
          <div>
            <div class="text-sky-50 font-bold text-lg tracking-wide">海外</div>
            <div class="text-sky-100/70 text-xs tracking-[0.2em] uppercase">Overseas</div>
          </div>
          <div class="text-right">
            <!-- 幅が狭いと地球の縁と重なるので下地を敷く -->
            <div class="text-emerald-200 font-semibold text-sm rounded-full bg-[#060a1c]/70 backdrop-blur-sm px-2.5 py-0.5">準備中</div>
          </div>
        </div>
        <div class="px-5 pb-4 flex-1 flex items-center justify-start gap-2 text-sky-100/60 min-h-[4.5rem]">
          <svg
            class="w-4 h-4 shrink-0"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
            <path d="M2 12h20" />
          </svg>
          <span class="text-xs">投稿はまだありません</span>
        </div>
      </div>
    </div>

    <!-- 旅・聖地巡礼・テーマは見出しだけ置いて詳細ページへ送る（セクションが長くなりすぎるため） -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href="/journey/trips/" class="glass rounded-2xl p-6 hover-lift flex items-center justify-between group">
        <div>
          <div class="text-2xl font-bold gradient-text-cyan mb-1">旅の記録</div>
          <div class="text-gray-400 text-sm">{trips.length}件の旅・{tripPostCount}件の投稿</div>
        </div>
        <svg class="w-6 h-6 text-gray-500 group-hover:text-cyan-400 group-hover:translate-x-1 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <a href="/journey/pilgrimage/" class="glass rounded-2xl p-6 hover-lift flex items-center justify-between group border border-violet-500/20">
        <div>
          <div class="text-2xl font-bold gradient-text mb-1">聖地巡礼</div>
          <div class="text-gray-400 text-sm">{workCount}作品・{workPostCount}件の投稿</div>
        </div>
        <svg class="w-6 h-6 text-gray-500 group-hover:text-violet-300 group-hover:translate-x-1 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <a href="/journey/themes/" class="glass rounded-2xl p-6 hover-lift flex items-center justify-between group">
        <div>
          <div class="text-2xl font-bold gradient-text-cyan mb-1">テーマ</div>
          <div class="text-gray-400 text-sm">{themes.length}のテーマ・{themePostCount}件の投稿</div>
        </div>
        <svg class="w-6 h-6 text-gray-500 group-hover:text-cyan-400 group-hover:translate-x-1 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- Instagram リンクバナー -->
    <div class="mt-12 text-center">
      <a
        href="https://www.instagram.com/a_traveler_who_pursue_nature/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex max-w-full items-center gap-2 sm:gap-3 px-4 sm:px-8 py-4 glass rounded-2xl hover:bg-white/10 transition-colors group"
      >
        <svg class="w-6 h-6 shrink-0 text-pink-400 group-hover:text-pink-300 transition-colors" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        <div class="text-left min-w-0">
          <!-- ハンドルが長いので、狭い画面では文字を詰めて枠内に収める -->
          <div class="text-white font-semibold text-xs sm:text-sm truncate">@a_traveler_who_pursue_nature</div>
          <div class="text-gray-400 text-[11px] sm:text-xs">旅の写真をInstagramで公開中</div>
        </div>
        <svg class="w-4 h-4 shrink-0 text-gray-400 group-hover:text-white transition-colors ml-1 sm:ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

    <!-- 統計 -->
    <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-6">
      <div class="text-center glass p-6 rounded-2xl hover-lift">
        <div class="text-3xl font-bold gradient-text-cyan mb-2">{visitedCount}</div>
        <p class="text-gray-300 text-sm">訪問済み都道府県</p>
      </div>
      <div class="text-center glass p-6 rounded-2xl hover-lift">
        <div class="text-3xl font-bold gradient-text mb-2">{totalCount - visitedCount}</div>
        <p class="text-gray-300 text-sm">まだ見ぬ土地</p>
      </div>
      <div class="text-center glass p-6 rounded-2xl hover-lift">
        <div class="text-3xl font-bold gradient-text-cyan mb-2">{visitedRegionCount}</div>
        <p class="text-gray-300 text-sm">訪問済み地方</p>
      </div>
      <div class="text-center glass p-6 rounded-2xl hover-lift">
        <div class="text-3xl font-bold gradient-text mb-2">{postCount}</div>
        <p class="text-gray-300 text-sm">記録した投稿</p>
      </div>
    </div>
  </div>

  <!-- セクション区切り線 -->
  <div class="section-divider"></div>
</section>

<style>
  /* 地方の形の透かし。透明度は図形ごとではなく全体にかける（県境で重なった所が濃く浮くため）。
     県境の簡略化で出る細い隙間は、同色の線で埋める */
  .region-silhouette {
    opacity: 0.3;
  }
  .region-silhouette path {
    fill: #fff;
    stroke: #fff;
    stroke-width: 0.8;
    stroke-linejoin: round;
  }
  /* global.css がライトモードで塗り替えるクラスに頼らず、昼も夜も同じ見た目で描く */
  .overseas-earth {
    background:
      /* 陸 */
      radial-gradient(circle 34px at 86% 88%, rgb(34 197 94 / 0.95), rgb(21 128 61 / 0.75) 60%, transparent 100%),
      radial-gradient(circle 22px at 74% 104%, rgb(22 163 74 / 0.9), transparent 100%),
      radial-gradient(circle 16px at 95% 70%, rgb(132 204 22 / 0.8), transparent 100%),
      /* 星 */
      radial-gradient(1.5px 1.5px at 8% 22%, rgb(255 255 255 / 0.85), transparent),
      radial-gradient(1px 1px at 22% 70%, rgb(255 255 255 / 0.6), transparent),
      radial-gradient(1px 1px at 38% 38%, rgb(255 255 255 / 0.55), transparent),
      radial-gradient(1.5px 1.5px at 55% 14%, rgb(255 255 255 / 0.7), transparent),
      radial-gradient(1px 1px at 47% 82%, rgb(255 255 255 / 0.5), transparent),
      radial-gradient(1px 1px at 66% 48%, rgb(255 255 255 / 0.45), transparent),
      /* 海と大気の縁 */
      radial-gradient(circle 150px at 100% 120%, #1e3a8a 0%, #1d4ed8 55%, #2563eb 80%, #38bdf8 92%, #e0f2fe 95%, rgb(56 189 248 / 0.35) 97%, transparent 100%),
      #060a1c;
  }
</style>
