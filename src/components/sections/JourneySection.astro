---
// JourneySection.astro - 旅の記録セクション
//
// 都道府県（8地方）・旅・聖地巡礼の3本立て。3つの軸は排他ではなく、
// 同じ投稿が県ページにも旅ページにも聖地巡礼ページにも出るのは仕様。
//
// 47都道府県のデータは data/journey/prefectures.json に移してある
// （以前はこのファイルにベタ書きしていた）。投稿との対応は
// scripts/journey/resolve.py が作る resolved.json が持つ。
import {
  regions,
  trips,
  works,
  workCount,
  themes,
  posts,
  postCountByPrefecture,
} from '../../lib/journey';
// 地方の形の透かし（scripts/journey/build_region_silhouettes.py が県境から作る）
import silhouettes from '../../lib/region-silhouettes.json';
import TripCard from '../journey/TripCard.astro';

const silhouetteByRegion: Record<string, { viewBox: string; d: string }> = silhouettes;

const allPrefectures = regions.flatMap((region) => region.prefectures);
const visitedCount = allPrefectures.filter((p) => p.visited).length;
const totalCount = allPrefectures.length;
const visitedRegionCount = regions.filter((r) => r.prefectures.some((p) => p.visited)).length;
const postCount = posts.length;
const tripPostCount = trips.reduce((sum, trip) => sum + trip.postCount, 0);
const workPostCount = works.reduce((sum, work) => sum + work.postCount, 0);
const themePostCount = themes.reduce((sum, theme) => sum + theme.postCount, 0);
// 旅の帯に並べる旅（新しい順）。トップで旅の写真が見えるのはここだけ
const tripsByDate = [...trips].sort((a, b) => b.start.localeCompare(a.start));

---

<section id="journey" class="py-20 relative">
  <div class="container mx-auto px-6">
    <!-- セクションタイトル -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold gradient-text mb-4">Journey</h2>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto">
        日本各地を旅しながら出会った風景や自然を記録しています。<br>
        その土地にしかない空気感と光を求めて、今日も旅を続けています。
      </p>
    </div>

    <!-- 旅の帯。写真が目に入るように地方の一覧より先に置く。全部の旅を新しい順に横へ並べ、
         端まで行っても途切れないよう同じ並びを2周ぶん置く（1周目は複製で、読み上げとタブ移動から外す）。
         手でも横にスクロールでき、ふだんは時間で少しずつ右へ流れる。動きは下の <script> -->
    {tripsByDate.length > 0 && (
      <div class="mb-8">
        <div class="flex items-center justify-between gap-4 mb-4">
          <h3 class="text-xl font-bold text-white">これまでの旅</h3>
          <div class="flex items-center gap-2 shrink-0">
            <button type="button" class="trip-reel-step glass rounded-full w-8 h-8 hidden sm:flex items-center justify-center text-gray-400 hover:text-cyan-400 transition-colors" data-step="-1" aria-label="前の旅へ">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
            </button>
            <button type="button" class="trip-reel-toggle glass rounded-full w-8 h-8 flex items-center justify-center text-gray-400 hover:text-cyan-400 transition-colors" aria-label="流れを止める">
              <svg class="reel-icon-pause w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3v14H7zM14 5h3v14h-3z" /></svg>
              <svg class="reel-icon-play w-4 h-4 hidden" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
            </button>
            <button type="button" class="trip-reel-step glass rounded-full w-8 h-8 hidden sm:flex items-center justify-center text-gray-400 hover:text-cyan-400 transition-colors" data-step="1" aria-label="次の旅へ">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </button>
            <a href="/journey/trips/" class="ml-2 text-sm text-gray-400 hover:text-cyan-400 transition-colors">
              一覧（{trips.length}件）→
            </a>
          </div>
        </div>
        <div class="trip-reel -mx-6 overflow-x-auto" data-trip-reel role="region" aria-label="これまでの旅（横にスクロールできます）">
          <!-- 上下の余白は、カーソルを乗せたカードが浮く分（5px）と影の分。横にスクロールする箱は上下もはみ出しを切るため -->
          <div class="flex w-max gap-4 px-6 pt-2 pb-6">
            {[0, 1].map((copy) => (
              <div class="flex gap-4" data-reel-set={copy} aria-hidden={copy === 0 ? 'true' : undefined}>
                {tripsByDate.map((trip) => (
                  <div class="w-[78vw] max-w-[320px] sm:w-[300px] shrink-0">
                    <TripCard trip={trip} tabindex={copy === 0 ? -1 : undefined} />
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    )}

    <!-- 8地方＋海外のグリッド -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      {regions.map((region) => {
        const regionVisited = region.prefectures.filter(p => p.visited).length;
        const silhouette = silhouetteByRegion[region.name];
        const [, , silW, silH] = silhouette ? silhouette.viewBox.split(' ').map(Number) : [0, 0, 1, 1];
        return (
          <div class="glass rounded-2xl overflow-hidden hover-lift">
            <!-- ヘッダー。global.css がライトモードで bg-gradient-to-* を一色に、text-white を黒に
                 塗り替えるので、それらを使わず昼も夜も地方ごとの色と白文字のままにする -->
            <div class={`relative overflow-hidden bg-linear-to-r ${region.gradient} px-5 py-4 flex items-center justify-between`}>
              {silhouette && (
                <svg
                  class="region-silhouette pointer-events-none absolute right-16 top-1/2 -translate-y-1/2 h-[118%]"
                  style={`aspect-ratio: ${silW} / ${silH}`}
                  viewBox={silhouette.viewBox}
                  aria-hidden="true"
                >
                  <path d={silhouette.d} />
                </svg>
              )}
              <div class="relative">
                <div class="text-slate-50 font-bold text-lg">{region.name}</div>
                <div class="text-slate-50/75 text-xs">{region.en}</div>
              </div>
              <div class="relative text-right">
                <div class="text-slate-50 font-semibold text-sm">{regionVisited} / {region.prefectures.length}</div>
                <div class="text-slate-50/75 text-xs">都道府県</div>
              </div>
            </div>

            <!-- 都道府県バッジ -->
            <div class="p-4">
              <div class="flex flex-wrap gap-2">
                {region.prefectures.map((pref) => {
                  const count = postCountByPrefecture[pref.code] ?? 0;
                  const Tag = pref.visited ? 'a' : 'div';
                  return (
                  <Tag
                    class="group/pref relative"
                    href={pref.visited ? `/journey/${pref.slug}/` : undefined}
                    title={pref.note ?? pref.name}
                  >
                    <span class={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium transition-all ${
                      pref.visited
                        ? 'bg-white/20 text-white border border-white/30 hover:bg-white/30'
                        : 'bg-white/5 text-gray-500 border border-white/10'
                    }`}>
                      {pref.shortName}
                      {count > 0 ? (
                        <span class="ml-1 text-white/60 text-[10px]">{count}</span>
                      ) : pref.visited ? (
                        <span class="ml-1 text-green-400 text-xs">✓</span>
                      ) : null}
                    </span>
                    {pref.note && (
                      <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-1 px-2 py-1 bg-gray-800 text-white text-xs rounded whitespace-nowrap opacity-0 group-hover/pref:opacity-100 transition-opacity pointer-events-none z-10">
                        {pref.note}
                      </div>
                    )}
                  </Tag>
                  );
                })}
              </div>
            </div>
          </div>
        );
      })}

      <!-- 9枠目は海外。投稿が出るまでは空のままリンクにしない。2列のときは1枚だけの行になるので横に広げる -->
      <!-- 宇宙から見た地球（右下から昇る）。背景は下の <style> の .overseas-earth -->
      <div
        class="overseas-earth rounded-2xl overflow-hidden flex flex-col md:col-span-2 xl:col-span-1 cursor-default border border-sky-300/30 shadow-[0_0_28px_rgba(56,189,248,0.18)]"
        aria-disabled="true"
      >
        <div class="px-5 py-4 flex items-center justify-between">
          <div>
            <div class="text-sky-50 font-bold text-lg tracking-wide">海外</div>
            <div class="text-sky-100/70 text-xs tracking-[0.2em] uppercase">Overseas</div>
          </div>
          <div class="text-right">
            <!-- 幅が狭いと地球の縁と重なるので下地を敷く -->
            <div class="text-emerald-200 font-semibold text-sm rounded-full bg-[#060a1c]/70 backdrop-blur-sm px-2.5 py-0.5">準備中</div>
          </div>
        </div>
        <div class="px-5 pb-4 flex-1 flex items-center justify-start gap-2 text-sky-100/60 min-h-[4.5rem]">
          <svg
            class="w-4 h-4 shrink-0"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
            <path d="M2 12h20" />
          </svg>
          <span class="text-xs">投稿はまだありません</span>
        </div>
      </div>
    </div>

    <!-- 旅・聖地巡礼・テーマは見出しだけ置いて詳細ページへ送る（セクションが長くなりすぎるため） -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href="/journey/trips/" class="glass rounded-2xl p-6 hover-lift flex items-center justify-between group">
        <div>
          <div class="text-2xl font-bold gradient-text-cyan mb-1">旅の記録</div>
          <div class="text-gray-400 text-sm">{trips.length}件の旅・{tripPostCount}件の投稿</div>
        </div>
        <svg class="w-6 h-6 text-gray-500 group-hover:text-cyan-400 group-hover:translate-x-1 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <a href="/journey/pilgrimage/" class="glass rounded-2xl p-6 hover-lift flex items-center justify-between group border border-violet-500/20">
        <div>
          <div class="text-2xl font-bold gradient-text mb-1">聖地巡礼</div>
          <div class="text-gray-400 text-sm">{workCount}作品・{workPostCount}件の投稿</div>
        </div>
        <svg class="w-6 h-6 text-gray-500 group-hover:text-violet-300 group-hover:translate-x-1 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <a href="/journey/themes/" class="glass rounded-2xl p-6 hover-lift flex items-center justify-between group">
        <div>
          <div class="text-2xl font-bold gradient-text-cyan mb-1">テーマ</div>
          <div class="text-gray-400 text-sm">{themes.length}のテーマ・{themePostCount}件の投稿</div>
        </div>
        <svg class="w-6 h-6 text-gray-500 group-hover:text-cyan-400 group-hover:translate-x-1 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- Instagram リンクバナー -->
    <div class="mt-12 text-center">
      <a
        href="https://www.instagram.com/a_traveler_who_pursue_nature/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex max-w-full items-center gap-2 sm:gap-3 px-4 sm:px-8 py-4 glass rounded-2xl hover:bg-white/10 transition-colors group"
      >
        <svg class="w-6 h-6 shrink-0 text-pink-400 group-hover:text-pink-300 transition-colors" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        <div class="text-left min-w-0">
          <!-- ハンドルが長いので、狭い画面では文字を詰めて枠内に収める -->
          <div class="text-white font-semibold text-xs sm:text-sm truncate">@a_traveler_who_pursue_nature</div>
          <div class="text-gray-400 text-[11px] sm:text-xs">旅の写真をInstagramで公開中</div>
        </div>
        <svg class="w-4 h-4 shrink-0 text-gray-400 group-hover:text-white transition-colors ml-1 sm:ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

    <!-- 統計 -->
    <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-6">
      <div class="text-center glass p-6 rounded-2xl hover-lift">
        <div class="text-3xl font-bold gradient-text-cyan mb-2">{visitedCount}</div>
        <p class="text-gray-300 text-sm">訪問済み都道府県</p>
      </div>
      <div class="text-center glass p-6 rounded-2xl hover-lift">
        <div class="text-3xl font-bold gradient-text mb-2">{totalCount - visitedCount}</div>
        <p class="text-gray-300 text-sm">まだ見ぬ土地</p>
      </div>
      <div class="text-center glass p-6 rounded-2xl hover-lift">
        <div class="text-3xl font-bold gradient-text-cyan mb-2">{visitedRegionCount}</div>
        <p class="text-gray-300 text-sm">訪問済み地方</p>
      </div>
      <div class="text-center glass p-6 rounded-2xl hover-lift">
        <div class="text-3xl font-bold gradient-text mb-2">{postCount}</div>
        <p class="text-gray-300 text-sm">記録した投稿</p>
      </div>
    </div>
  </div>

  <!-- セクション区切り線 -->
  <div class="section-divider"></div>
</section>

<style>
  /* 地方の形の透かし。透明度は図形ごとではなく全体にかける（県境で重なった所が濃く浮くため）。
     県境の簡略化で出る細い隙間は、同色の線で埋める */
  .region-silhouette {
    opacity: 0.3;
  }
  .region-silhouette path {
    fill: #fff;
    stroke: #fff;
    stroke-width: 0.8;
    stroke-linejoin: round;
  }
  /* global.css がライトモードで塗り替えるクラスに頼らず、昼も夜も同じ見た目で描く */
  .overseas-earth {
    background:
      /* 陸 */
      radial-gradient(circle 34px at 86% 88%, rgb(34 197 94 / 0.95), rgb(21 128 61 / 0.75) 60%, transparent 100%),
      radial-gradient(circle 22px at 74% 104%, rgb(22 163 74 / 0.9), transparent 100%),
      radial-gradient(circle 16px at 95% 70%, rgb(132 204 22 / 0.8), transparent 100%),
      /* 星 */
      radial-gradient(1.5px 1.5px at 8% 22%, rgb(255 255 255 / 0.85), transparent),
      radial-gradient(1px 1px at 22% 70%, rgb(255 255 255 / 0.6), transparent),
      radial-gradient(1px 1px at 38% 38%, rgb(255 255 255 / 0.55), transparent),
      radial-gradient(1.5px 1.5px at 55% 14%, rgb(255 255 255 / 0.7), transparent),
      radial-gradient(1px 1px at 47% 82%, rgb(255 255 255 / 0.5), transparent),
      radial-gradient(1px 1px at 66% 48%, rgb(255 255 255 / 0.45), transparent),
      /* 海と大気の縁 */
      radial-gradient(circle 150px at 100% 120%, #1e3a8a 0%, #1d4ed8 55%, #2563eb 80%, #38bdf8 92%, #e0f2fe 95%, rgb(56 189 248 / 0.35) 97%, transparent 100%),
      #060a1c;
  }

  /* 旅の帯。左右の端を淡くして、まだ続いていることを見せる。スクロールバーは出さない
     （途切れずにつながるので位置の目安にならない。PC は前後のボタン、スマホは指で動かす） */
  .trip-reel {
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 24px, #000 calc(100% - 24px), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 24px, #000 calc(100% - 24px), transparent 100%);
    scrollbar-width: none;
    /* global.css の scroll-behavior: smooth が効くと、毎フレーム位置を変えるたびに
       なめらかな移動が始め直しになって流れない。帯の中だけ即時にする */
    scroll-behavior: auto;
  }
  .trip-reel::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // 旅の帯。同じ並びを2周ぶん置き、端に近づいたら1周ぶん位置を戻して、途切れずにつながって見せる。
  // ふだんは時間で少しずつ右へ流す（中身が右へ動く）。カーソルを乗せている間・触った直後・画面の外にある間は止め、
  // 止めるボタンで止めたままにもできる。「動きを減らす」の設定の人には流さない。
  const SPEED = 24; // 1秒に動かす px
  const RESUME_DELAY = 2500; // 手で動かしたあと、流れを戻すまでの ms

  const setup = () => {
    const reel = document.querySelector<HTMLElement>('[data-trip-reel]');
    if (!reel || reel.dataset.ready) return;
    const sets = reel.querySelectorAll<HTMLElement>('[data-reel-set]');
    if (sets.length < 2) return;
    reel.dataset.ready = '1';

    const toggle = document.querySelector<HTMLButtonElement>('.trip-reel-toggle');
    const steps = document.querySelectorAll<HTMLButtonElement>('.trip-reel-step');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    // 1周の長さ（2周目の先頭 - 1周目の先頭。間の余白を含む）
    const period = () => sets[1].offsetLeft - sets[0].offsetLeft;
    const inset = () => sets[0].offsetLeft;
    // 1周の4分の1より左、または1と4分の1周より右へ出たら、1周ぶん戻す。見えている絵は同じなので気づかれない
    const wrap = (value: number) => {
      const p = period();
      if (p <= 0) return value;
      if (value < p * 0.25) return value + p;
      if (value >= p * 1.25) return value - p;
      return value;
    };

    // 2周目（読み上げの対象のほう）の先頭、いちばん新しい旅から始める
    let pos = sets[1].offsetLeft - inset();
    let target: number | null = null;
    let last = 0;
    let visible = true;
    let hovering = false;
    let holdUntil = 0;
    let stopped = reduce.matches;
    reel.scrollLeft = pos;

    const render = () => {
      if (!toggle) return;
      toggle.setAttribute('aria-label', stopped ? '流れを再開する' : '流れを止める');
      toggle.querySelector('.reel-icon-pause')?.classList.toggle('hidden', stopped);
      toggle.querySelector('.reel-icon-play')?.classList.toggle('hidden', !stopped);
    };
    render();

    const tick = (now: number) => {
      if (!reel.isConnected) return; // ページを移ったら止める
      const dt = last ? Math.min(now - last, 100) : 0;
      last = now;
      if (target !== null) {
        // 前後のボタンで1枚ぶん送るときは、目標へなめらかに寄せる
        const before = pos;
        pos += (target - pos) * Math.min(1, dt / 120);
        if (Math.abs(target - pos) < 0.5) {
          pos = target;
          target = null;
        }
        const wrapped = wrap(pos);
        if (target !== null) target += wrapped - pos;
        pos = wrapped;
        if (pos !== before) reel.scrollLeft = pos;
      } else if (!stopped && visible && !hovering && now >= holdUntil) {
        pos = wrap(pos - (SPEED * dt) / 1000);
        reel.scrollLeft = pos;
      }
      requestAnimationFrame(tick);
    };

    // 手で動かしたら、その位置を引き継ぐ（流している間の差は1px未満なので、2px を超えたら手で動かしたとみなす）
    reel.addEventListener(
      'scroll',
      () => {
        if (target !== null || Math.abs(reel.scrollLeft - pos) <= 2) return;
        pos = reel.scrollLeft;
        const wrapped = wrap(pos);
        if (wrapped !== pos) {
          pos = wrapped;
          reel.scrollLeft = pos;
        }
      },
      { passive: true },
    );
    const hold = () => {
      holdUntil = performance.now() + RESUME_DELAY;
    };
    reel.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') hovering = true;
    });
    reel.addEventListener('pointerleave', () => {
      hovering = false;
    });
    reel.addEventListener('pointerdown', hold);
    reel.addEventListener('touchmove', hold, { passive: true });
    reel.addEventListener('wheel', hold, { passive: true });
    reel.addEventListener('focusin', () => {
      hovering = true;
    });
    reel.addEventListener('focusout', () => {
      hovering = false;
    });
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
    }).observe(reel);

    toggle?.addEventListener('click', () => {
      stopped = !stopped;
      render();
    });
    reduce.addEventListener('change', () => {
      stopped = reduce.matches;
      render();
    });
    steps.forEach((button) => {
      button.addEventListener('click', () => {
        const card = sets[1].firstElementChild as HTMLElement | null;
        const step = (card?.offsetWidth ?? 300) + 16;
        const base = target ?? pos;
        hold();
        if (reduce.matches) {
          pos = wrap(base + step * Number(button.dataset.step));
          reel.scrollLeft = pos;
        } else {
          target = base + step * Number(button.dataset.step);
        }
      });
    });

    requestAnimationFrame(tick);
  };

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
