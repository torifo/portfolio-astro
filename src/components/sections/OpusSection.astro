---
// OpusSection.astro - 開発実績セクション（microCMS連携）
import { cmsImage, fetchAllOpus, generateSlug, SKILL_CATEGORY_SLUG } from '../../lib/microcms';
import type { Opus, RelatedSkill } from '../../lib/microcms';

let opus: Opus[] = [];
let allCategories: string[] = [];

try {
  opus = await fetchAllOpus();
  // category:[] のアイテムはtitleをカテゴリとして使用（APIデータから導出）
  allCategories = [...new Set(opus.flatMap(item =>
    item.category.length > 0 ? item.category : [item.title]
  ))];
} catch (error) {
  console.error('Failed to fetch opus:', error);
}

// グリッドにはrelatedLinksがあるもののみ表示（Application等はフィルターには出るがグリッドに含めない）
const visibleOpus = opus.filter(item => item.relatedLinks.length > 0);

// カテゴリ別の色マッピング
const getCategoryColor = (category: string) => {
  const categoryColors: Record<string, string> = {
    'Web': 'bg-cyan-500/20 text-cyan-300',
    'Discord Bot': 'bg-purple-500/20 text-purple-300',
    'Bot': 'bg-indigo-500/20 text-indigo-300',
    'Game': 'bg-green-500/20 text-green-300',
    'TODO': 'bg-orange-500/20 text-orange-300',
    'LP': 'bg-pink-500/20 text-pink-300',
    'CLI': 'bg-yellow-500/20 text-yellow-300',
    'Application': 'bg-blue-500/20 text-blue-300',
  };
  return categoryColors[category] || 'bg-gray-500/20 text-gray-300';
};

// スキルカテゴリ別の色マッピング
const getSkillCategoryColor = (category: string) => {
  const colors: Record<string, string> = {
    'プログラミング言語': 'bg-blue-500/20 text-blue-300',
    'フレームワーク・ライブラリ': 'bg-purple-500/20 text-purple-300',
    'データベース': 'bg-green-500/20 text-green-300',
    'マークアップ・スタイルシート': 'bg-orange-500/20 text-orange-300',
    'Web技術 / アーキテクチャ / ネットワーク': 'bg-cyan-500/20 text-cyan-300',
    'デプロイ・インフラ・OS': 'bg-red-500/20 text-red-300',
    '開発ツール・CI/CD': 'bg-yellow-500/20 text-yellow-300',
    '数値解析・自動化(マクロ)': 'bg-pink-500/20 text-pink-300',
  };
  return colors[category] || 'bg-gray-500/20 text-gray-300';
};

// relatedSkillをカテゴリ別にグループ化（categoryOrder順）
const skillCategoryOrder = [
  'プログラミング言語', 'フレームワーク・ライブラリ', 'データベース',
  'マークアップ・スタイルシート', 'Web技術 / アーキテクチャ / ネットワーク',
  'デプロイ・インフラ・OS', '開発ツール・CI/CD', '数値解析・自動化(マクロ)',
];
const groupSkillsByCategory = (skills: RelatedSkill[]) => {
  const grouped = skills.reduce((acc, skill) => {
    const cat = skill.category[0] || 'その他';
    if (!acc[cat]) acc[cat] = [];
    acc[cat].push(skill);
    return acc;
  }, {} as Record<string, RelatedSkill[]>);
  return Object.entries(grouped).sort(([a], [b]) => {
    const ia = skillCategoryOrder.indexOf(a);
    const ib = skillCategoryOrder.indexOf(b);
    return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib);
  });
};

// 画像のないカードの色付きグラデーション（colorPatterns）は、絵文字の代わりに線画のプレースホルダーを置いたので撤去（2026-11-11 レビューで修正）

// 各カードで最初から開いておく作品の数。スマホでは作品がすべて折りたたまれていて、
// 初めて来た人に作品が一つも見えなかったため、先頭のこの件数だけは常に出す（2026-11-11 レビューで修正）
const WORKS_PREVIEW_COUNT = 2;

// SVG はロゴの素材で、絵の端が viewBox の端にぴったり接している（Discord のロゴは左右とも余白ゼロ）。
// object-contain だと枠の左右いっぱいまで広がり、切れて見えたので、SVG にだけ内側の余白を付ける（2026-11-11 レビューで修正）
const isVectorImage = (url: string) => /\.svg$/i.test(new URL(url).pathname);

// 動的グリッドクラスを決定する関数（最大3列・均等レイアウト優先）
// 4件 → 2列(2+2)、5件以上 → 3列(3+2, 3+3, ...)
const getGridColumns = (itemCount: number) => {
  if (itemCount === 1) return 'grid-cols-1';
  if (itemCount === 2) return 'grid-cols-1 md:grid-cols-2';
  if (itemCount === 3) return 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3';
  if (itemCount === 4) return 'grid-cols-1 md:grid-cols-2';
  return 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3';
};
---

<section id="opus" class="py-20 relative">
  <div class="container mx-auto px-6">
    <!-- セクションタイトル -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold gradient-text mb-4">Opus</h2>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto">
        これまでに手がけた主要な開発プロジェクトをご紹介します。<br>
        技術選定から実装まで、一貫してこだわり抜いて制作しています。
      </p>
    </div>

    <!-- カテゴリーフィルター -->
    {allCategories.length > 0 && (
      <div class="mb-12 text-center">
        <div class="flex flex-wrap justify-center gap-3">
          <button
            class="px-4 py-2 bg-white/10 text-white rounded-full text-sm font-medium transition-all hover:bg-white/20 cursor-pointer category-filter-btn active-filter"
            data-category="all"
            type="button"
            aria-pressed="true"
          >
            All
          </button>
          {allCategories.map((category) => (
            <button
              class={`px-4 py-2 ${getCategoryColor(category)} rounded-full text-sm font-medium transition-all cursor-pointer category-filter-btn`}
              data-category={category}
              type="button"
              aria-pressed="false"
            >
              {category}
            </button>
          ))}
        </div>
      </div>
    )}

    <!-- プロジェクトグリッド -->
    <div class={`grid ${getGridColumns(visibleOpus.length)} gap-8`}>
      {visibleOpus.map((project) => {
        const galleryImages = project.galleryTypes || [];
        const hasMultipleGalleryImages = galleryImages.length > 1;
        const extraWorksCount = Math.max(project.relatedLinks.length - WORKS_PREVIEW_COUNT, 0);

        return (
          <div class="glass rounded-2xl overflow-hidden hover-lift opus-project-card" data-categories={project.category.join(',')}>
            <div class="relative overflow-hidden">
              {/* 上の画像はスマホでは低くする。作品を最初から開いて見せる分、縦に長くなりすぎないように（2026-11-11 レビューで修正） */}
              {galleryImages.length > 0 ? (
                <div class="w-full h-40 md:h-64 relative bg-gray-900 group/main-gallery">
                  <div class="relative w-full h-full flex items-center justify-center">
                    {galleryImages.map((img, imgIndex) => (
                      <img
                        src={cmsImage(img.url, { w: 728, h: 256 })}
                        alt={`${project.title} - ${imgIndex + 1}`}
                        loading="lazy"
                        decoding="async"
                        class={`absolute inset-0 w-full h-full object-contain ${isVectorImage(img.url) ? 'p-4 md:p-6' : ''} transition-opacity duration-300 main-gallery-image-${project.id}`}
                        data-index={imgIndex}
                        style={imgIndex === 0 ? 'opacity: 1;' : 'opacity: 0;'}
                      />
                    ))}
                  </div>
                  {/* 画像に重ねていたタイトルと、それを読ませるための下側の暗いグラデーションは撤去。
                      白い画像の上で白文字が読めず、ライトモードでは濁った灰色になり、すぐ下の h3 とも重複していた（2026-11-11 レビューで修正） */}
                  {hasMultipleGalleryImages && (
                    <>
                      <button
                        class="absolute left-2 top-1/2 -translate-y-1/2 bg-black/60 hover:bg-black/80 text-white p-2 rounded opacity-0 group-hover/main-gallery:opacity-100 transition-opacity z-10"
                        onclick={`prevMainImage('${project.id}', ${galleryImages.length}); event.stopPropagation();`}
                        type="button"
                      >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                        </svg>
                      </button>
                      <button
                        class="absolute right-2 top-1/2 -translate-y-1/2 bg-black/60 hover:bg-black/80 text-white p-2 rounded opacity-0 group-hover/main-gallery:opacity-100 transition-opacity z-10"
                        onclick={`nextMainImage('${project.id}', ${galleryImages.length}); event.stopPropagation();`}
                        type="button"
                      >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                      </button>
                      {/* 重ねていたタイトルを外したので、点は画像の下端へ寄せる。暗いグラデーションがなくなった分、明るい画像でも見えるよう縁を付ける（2026-11-11 レビューで修正） */}
                      <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-1.5 z-10">
                        {galleryImages.map((_, dotIndex) => (
                          <div
                            class={`w-2 h-2 rounded-full ring-1 ring-black/30 transition-colors main-gallery-dot-${project.id}`}
                            data-index={dotIndex}
                            style={dotIndex === 0 ? 'background-color: rgb(34, 211, 238);' : 'background-color: rgba(255, 255, 255, 0.5);'}
                          ></div>
                        ))}
                      </div>
                    </>
                  )}
                </div>
              ) : (
                <div class="w-full h-40 md:h-64 bg-gray-900 flex items-center justify-center opus-image-placeholder" aria-hidden="true">
                  {/* 画像のないカード（今は Game）は、ロケットの絵文字ではなく線画の置き場所を出す。
                      地は画像枠と同じ bg-gray-900（ライトモードでは global.css が淡い灰色にする）、線の色は下の <style> で両テーマ分を持つ（2026-11-11 レビューで修正） */}
                  <svg class="w-14 h-14" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="8" y="17" width="32" height="23" rx="3" />
                    <path d="M12 12.5h24" />
                    <path d="M16 8h16" />
                    <path d="M15 33l6-6 4 4 3-3 5 5" />
                    <circle cx="30" cy="23.5" r="1.75" />
                  </svg>
                </div>
              )}
              {/* 画像に乗せていたホバー時の暗転と、その上の GitHub アイコン・詳細ボタンは撤去。
                  詳細ボタンはどこにもクリック処理がなく、GitHub と詳細へのリンクは各作品の下に同じものがある（2026-11-11 レビューで修正） */}
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-white mb-2">{project.title}</h3>
              <div class="text-gray-400 text-sm mb-4 line-clamp-3" set:html={project.description}></div>
              <div class="flex flex-wrap gap-2">
                {project.category.map((cat) => (
                  <span class={`px-3 py-1 ${getCategoryColor(cat)} rounded-full text-xs`}>
                    {cat}
                  </span>
                ))}
              </div>
              {/* 作品の一覧。見出しを「関連プロジェクト」から「作品」に変え、先頭 WORKS_PREVIEW_COUNT 件はどの幅でも開いておく。
                  残りは従来どおりスマホだけ折りたたみ（md 以上は常に表示）、「ほかN件」のボタンで開閉する（2026-11-11 レビューで修正） */}
              {project.relatedLinks.length > 0 && (
                <div class="mt-4 pt-4 border-t border-gray-700">
                  <h4 class="text-sm font-semibold text-white mb-3">作品 ({project.relatedLinks.length})</h4>
                  <div class="grid grid-cols-1 gap-3">
                    {project.relatedLinks.map((link, linkIndex) => {
                      const thumbnails = link.thumbnail || [];
                      const hasMultipleImages = thumbnails.length > 1;
                      const isExtra = linkIndex >= WORKS_PREVIEW_COUNT;
                      return (
                        <>
                        {linkIndex === WORKS_PREVIEW_COUNT && (
                          <button
                            class="md:hidden flex items-center justify-center gap-1 w-full py-2 rounded-lg border border-dashed border-gray-700 text-sm font-medium text-cyan-400 hover:text-cyan-300 cursor-pointer transition-colors related-toggle-btn"
                            data-project-id={project.id}
                            type="button"
                            aria-expanded="false"
                          >
                            <span>ほか{extraWorksCount}件</span>
                            <svg class="w-4 h-4 transition-transform" data-related-icon={project.id} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                          </button>
                        )}
                        <div
                          class={`bg-gray-800/50 rounded-lg p-3 hover:bg-gray-700/50 transition-colors ${isExtra ? 'hidden md:block' : ''}`}
                          data-related-extra={isExtra ? project.id : undefined}
                        >
                          {thumbnails.length > 0 && (
                            <div class="w-full aspect-video mb-3 rounded overflow-hidden bg-gray-900 relative group/gallery">
                              <div class="relative w-full h-full flex items-center justify-center">
                                {thumbnails.map((thumb, thumbIndex) => (
                                  <img
                                    src={cmsImage(thumb.url, { w: 656, h: 369 })}
                                    alt={`${link.service} - ${thumbIndex + 1}`}
                                    loading="lazy"
                                    decoding="async"
                                    class={`absolute inset-0 w-full h-full object-contain transition-opacity duration-300 gallery-image-${project.id}-${linkIndex}`}
                                    data-index={thumbIndex}
                                    style={thumbIndex === 0 ? 'opacity: 1;' : 'opacity: 0;'}
                                  />
                                ))}
                              </div>
                              {hasMultipleImages && (
                                <>
                                  <button
                                    class="absolute left-1 top-1/2 -translate-y-1/2 bg-black/60 hover:bg-black/80 text-white p-1 rounded opacity-0 group-hover/gallery:opacity-100 transition-opacity z-10"
                                    onclick={`prevImage('${project.id}-${linkIndex}', ${thumbnails.length}); event.stopPropagation();`}
                                    type="button"
                                  >
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                                    </svg>
                                  </button>
                                  <button
                                    class="absolute right-1 top-1/2 -translate-y-1/2 bg-black/60 hover:bg-black/80 text-white p-1 rounded opacity-0 group-hover/gallery:opacity-100 transition-opacity z-10"
                                    onclick={`nextImage('${project.id}-${linkIndex}', ${thumbnails.length}); event.stopPropagation();`}
                                    type="button"
                                  >
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                    </svg>
                                  </button>
                                  <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1 z-10">
                                    {thumbnails.map((_, dotIndex) => (
                                      <div
                                        class={`w-1.5 h-1.5 rounded-full transition-colors gallery-dot-${project.id}-${linkIndex}`}
                                        data-index={dotIndex}
                                        style={dotIndex === 0 ? 'background-color: rgb(34, 211, 238);' : 'background-color: rgba(255, 255, 255, 0.5);'}
                                      ></div>
                                    ))}
                                  </div>
                                </>
                              )}
                            </div>
                          )}
                          <div class="text-center">
                            {link.opusUrl ? (
                              <a
                                href={link.opusUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-sm text-white font-medium mb-1 hover:text-cyan-300 transition-colors inline-block"
                                title={link.service}
                              >
                                {link.service}
                              </a>
                            ) : (
                              <div class="text-sm text-white font-medium mb-1" title={link.service}>
                                {link.service}
                              </div>
                            )}
                            {/* スマホでは分野ごとの行分けをやめて一続きに折り返す（並び順と色は分野のまま）。
                                作品を最初から開いて見せる分、1分野1行だと縦に長くなりすぎたため。md 以上は従来どおり分野ごとに1行（2026-11-11 レビューで修正） */}
                            {link.relatedSkill && link.relatedSkill.length > 0 && (
                              <div class="mt-1 mb-1 flex flex-wrap justify-center gap-1 md:block md:space-y-1">
                                {groupSkillsByCategory(link.relatedSkill).map(([cat, catSkills]) => (
                                  <div class="contents md:flex md:flex-wrap md:justify-center md:gap-1">
                                    {catSkills.map((skill) => (
                                      <a
                                        href={`#skills-${SKILL_CATEGORY_SLUG[cat] ?? cat}`}
                                        class={`px-2 py-0.5 ${getSkillCategoryColor(cat)} rounded-full text-xs opacity-80 hover:opacity-100 transition-opacity`}
                                      >
                                        {skill.name}
                                      </a>
                                    ))}
                                  </div>
                                ))}
                              </div>
                            )}
                            <div class="flex justify-center gap-2 mt-1 flex-wrap">
                              <a
                                href={`/opus/${generateSlug(project.id, linkIndex)}`}
                                class="inline-flex items-center gap-1 text-xs text-cyan-400 hover:text-cyan-300 transition-colors"
                              >
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span>詳細</span>
                              </a>
                              {link.repoUrl && (
                                <a
                                  href={link.repoUrl}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="inline-flex items-center gap-1 text-xs text-gray-400 hover:text-cyan-300 transition-colors"
                                >
                                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                                  </svg>
                                  <span>GitHub</span>
                                </a>
                              )}
                            </div>
                          </div>
                        </div>
                        </>
                      );
                    })}
                  </div>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>

    <!-- 全体像への案内 -->
    <div class="mt-16">
      <div class="glass rounded-2xl p-6 md:p-8">
        <h3 class="text-white font-semibold text-lg mb-3">ここに載せているのは一部です</h3>
        <p class="text-gray-400 text-sm leading-relaxed mb-6">
          このセクションで紹介しているのは、意図や過程まで書き残しておきたい作品です。実際には100を超えるリポジトリを公開していて、公開中のサービスもここに並んでいるものだけではありません。全体を見たい場合は次の2つをどうぞ。
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a
            href="https://opulse-monitor.torifo.deno.net/"
            target="_blank"
            rel="noopener noreferrer"
            class="glass rounded-xl p-5 hover-lift block group border border-cyan-400/20"
          >
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span class="text-white font-medium">opulse — 稼働モニター</span>
            </div>
            <p class="text-gray-400 text-xs leading-relaxed mb-3">
              公開中のリポジトリの稼働・更新状況を1画面で見るために自作したダッシュボードです。時刻と天候で背景が変わります。ポートフォリオとは別のインフラ（Deno Deploy）に置いてあるので、こちらのサーバーが落ちていても見られます。
            </p>
            <span class="inline-flex items-center gap-1 text-xs text-cyan-300 group-hover:text-cyan-200 transition-colors">
              opulse-monitor.torifo.deno.net
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </span>
          </a>

          <a
            href="https://github.com/torifo?tab=repositories"
            target="_blank"
            rel="noopener noreferrer"
            class="glass rounded-xl p-5 hover-lift block group border border-white/10"
          >
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-4 h-4 text-gray-300" fill="currentColor" viewBox="0 0 24 24">
