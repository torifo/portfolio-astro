---
// 404.astro - 存在しないURLのときに出るページ。
// nginx が `try_files $uri $uri/ /index.html` でトップを 200 で返していたため、
// 壊れたリンクを踏んでも気づけなかった。nginx 側を `=404` + `error_page` に変え、
// その受け皿としてこのページを用意する。
// アイコンは Lucide (wrench / map / book-open) をインラインSVGで置いている。
// 他セクションと同じやり方で、依存を増やさないため。
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const links = [
  {
    href: '/#opus',
    label: 'Opus',
    note: '作ったもの',
    paths: [
      'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z',
    ],
  },
  {
    href: '/#journey',
    label: 'Journey',
    note: '旅の記録',
    paths: [
      'M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z',
      'M15 5.764v15',
      'M9 3.236v15',
    ],
  },
  {
    href: '/#skills',
    label: 'Skills',
    note: '使える技術',
    paths: [
      'M12 7v14',
      'M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z',
    ],
  },
];
---

<Layout
  title="404 Not Found | Toriforiumu"
  description="お探しのページは見つかりませんでした"
>
  <Header />

  <div class="min-h-screen pt-24 pb-16 relative flex items-center">
    <div class="container mx-auto px-6 max-w-2xl">

      <div class="glass rounded-2xl p-8 md:p-12 text-center">

        <p class="gradient-text text-7xl md:text-8xl font-bold leading-none mb-4">404</p>

        <h1 class="text-2xl md:text-3xl font-bold text-white mb-4">
          ページが見つかりませんでした
        </h1>

        <p class="text-gray-400 leading-relaxed mb-10">
          URLが変わったか、消えてしまったようです。<br class="hidden sm:block" />
          下のリンクから探してみてください。
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8">
          {links.map((link) => (
            <a
              href={link.href}
              class="glass rounded-xl py-4 px-3 hover-lift transition-all border border-white/10 hover:border-cyan-400/40"
            >
              <svg
                class="w-6 h-6 mx-auto mb-2 text-cyan-400"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {link.paths.map((d) => <path d={d} />)}
              </svg>
              <div class="text-white font-semibold text-sm">{link.label}</div>
              <div class="text-gray-400 text-xs mt-1">{link.note}</div>
            </a>
          ))}
        </div>

        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href="/"
            class="bg-gradient-to-r from-cyan-500 to-purple-500 text-white px-6 py-3 rounded-lg hover:from-cyan-600 hover:to-purple-600 transition-all duration-300 hover-lift font-semibold"
          >
            トップへ戻る
          </a>
          <a
            href="/contact"
            class="border-2 border-white/20 text-gray-300 px-6 py-3 rounded-lg hover:border-cyan-400/40 hover:text-white transition-all duration-300"
          >
            リンク切れを知らせる
          </a>
        </div>

      </div>

    </div>
  </div>

  <Footer />
</Layout>
