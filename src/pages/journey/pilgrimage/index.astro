---
// 聖地巡礼の一覧。作品ごとに、作品の画像を背景にした帯を重ねる（WorkBand）。
// 投稿の多い作品ほど帯を高くし、PC では文字の側を帯ごとに入れ替えて、雑誌の目次のように読ませる。1件の作品は細い帯を2列に並べる。
import Layout from '../../../layouts/Layout.astro';
import DetailHeader from '../../../components/DetailHeader.astro';
import WorkBand from '../../../components/journey/WorkBand.astro';
import { works, workCount } from '../../../lib/journey';

const postTotal = works.reduce((sum, work) => sum + work.postCount, 0);
// works は投稿の多い順（build_pilgrimages.py）。作品名なしは最後
const sizeOf = (count: number) => (count >= 9 ? 'feature' : count >= 2 ? 'medium' : 'compact');
const major = works.filter((work) => sizeOf(work.postCount) !== 'compact');
const minor = works.filter((work) => sizeOf(work.postCount) === 'compact');
---

<Layout title="聖地巡礼 - Toriforium Portfolio" description={`${workCount}作品・${postTotal}件の投稿`}>
  <DetailHeader title="聖地巡礼" backHref="/#journey" backLabel="ポートフォリオに戻る" />

  <main class="pt-24 pb-16 relative z-10">
    <div class="container mx-auto px-6 max-w-5xl">
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-4xl font-bold gradient-text mb-3">聖地巡礼</h1>
        <p class="text-gray-400 text-sm">作品の舞台を訪ねた記録です</p>
        <div class="flex flex-wrap justify-center gap-3 text-sm text-gray-400 mt-4">
          <span class="px-3 py-1 glass rounded-full">{workCount}作品</span>
          <span class="px-3 py-1 glass rounded-full">{postTotal}件の投稿</span>
        </div>
      </div>

      <ol class="space-y-5 md:space-y-6">
        {major.map((work, i) => (
          <li>
            <WorkBand work={work} index={i + 1} size={sizeOf(work.postCount)} flip={i % 2 === 1} />
          </li>
        ))}
      </ol>

      {minor.length > 0 && (
        <>
          <h2 class="text-sm font-semibold text-gray-400 mt-14 mb-4">ひとつの聖地を訪ねた作品</h2>
          <ol class="grid grid-cols-1 md:grid-cols-2 gap-4" start={major.length + 1}>
            {minor.map((work, i) => (
              <li>
                <WorkBand work={work} index={major.length + i + 1} size="compact" />
              </li>
            ))}
          </ol>
        </>
      )}
    </div>
  </main>
</Layout>
