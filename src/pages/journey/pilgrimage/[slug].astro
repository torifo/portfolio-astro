---
// 聖地巡礼ページ。作品ごとにまとめる。同じ投稿が県ページ・旅ページにも出るのは仕様。
import Layout from '../../../layouts/Layout.astro';
import DetailHeader from '../../../components/DetailHeader.astro';
import PostGrid from '../../../components/journey/PostGrid.astro';
import PrefectureChips from '../../../components/journey/PrefectureChips.astro';
import CoverHero from '../../../components/journey/CoverHero.astro';
import OfficialEmbeds from '../../../components/journey/OfficialEmbeds.astro';
import { works, postsForWork, prefectureByCode, formatRange, titleChunks, workCoverFor, workLinksFor, type Work } from '../../../lib/journey';

export async function getStaticPaths() {
  return works.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}

interface Props {
  work: Work;
}

const { work } = Astro.props;
const posts = postsForWork(work).slice().sort((a, b) => b.date.localeCompare(a.date));
const visited = work.prefCodes.map((code) => prefectureByCode(code)).filter(Boolean);
const heading = work.untitled ? '作品名のない聖地巡礼' : `${work.title}の聖地巡礼`;
const cover = work.untitled ? null : workCoverFor(work);
---

<Layout
  title={`${heading} - Toriforium Portfolio`}
  description={`${heading}${posts.length}件`}
>
  <DetailHeader title={heading} backHref="/#journey" backLabel="旅の記録に戻る" />

  <main class="pt-24 pb-16 relative z-10">
    <div class="container mx-auto px-6 max-w-5xl">
      <!-- 作品の画像を背景にした見出し（旅の見出しと同じ作り）。作品名なしは画像が無いので文字だけ -->
      {cover ? (
        <CoverHero cover={cover} credit={cover.credit} creditUrl={cover.source} class="mb-10">
          <p class="photo-meta text-xs tracking-[0.3em] mb-2">聖地巡礼</p>
          <h1 class="hero-title photo-title text-2xl md:text-4xl font-bold mb-3">
            {titleChunks(work.title).map((chunk, i) => <>{i > 0 && <wbr />}{chunk}</>)}
          </h1>
          <div class="flex flex-wrap justify-center gap-2 text-sm">
            <span class="photo-chip px-3 py-1 rounded-full">{formatRange(work.start, work.end)}</span>
            <span class="photo-chip px-3 py-1 rounded-full">{posts.length}件</span>
          </div>
        </CoverHero>
      ) : (
        <div class="text-center mb-10">
          <p class="text-xs text-violet-300 mb-2">聖地巡礼</p>
          <h1 class="text-2xl md:text-3xl font-bold gradient-text mb-3">{work.title}</h1>
          <div class="flex flex-wrap justify-center gap-3 text-sm text-gray-400">
            <span class="px-3 py-1 glass rounded-full">{formatRange(work.start, work.end)}</span>
            <span class="px-3 py-1 glass rounded-full">{posts.length}件</span>
          </div>
        </div>
      )}

      {!work.untitled && <OfficialEmbeds title={work.title} links={workLinksFor(work)} />}

      <section class="mb-8">
        <h2 class="text-sm font-semibold text-gray-400 mb-2">巡った県</h2>
        <PrefectureChips prefectures={visited} />
      </section>

      <div class="section-divider"></div>

      <PostGrid posts={posts} />
    </div>
  </main>
</Layout>
