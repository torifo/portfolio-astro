---
// 聖地巡礼ページ。作品ごとにまとめる。同じ投稿が県ページ・旅ページにも出るのは仕様。
import Layout from '../../../layouts/Layout.astro';
import DetailHeader from '../../../components/DetailHeader.astro';
import PostGrid from '../../../components/journey/PostGrid.astro';
import { works, postsForWork, prefectureByCode, formatRange, type Work } from '../../../lib/journey';

export async function getStaticPaths() {
  return works.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}

interface Props {
  work: Work;
}

const { work } = Astro.props;
const posts = postsForWork(work).slice().sort((a, b) => b.date.localeCompare(a.date));
const visited = work.prefCodes.map((code) => prefectureByCode(code)).filter(Boolean);
---

<Layout
  title={`${work.title}の聖地巡礼 - Toriforium Portfolio`}
  description={`${work.title}の聖地巡礼${posts.length}件`}
>
  <DetailHeader title={`${work.title}の聖地巡礼`} backHref="/#journey" backLabel="旅の記録に戻る" />

  <main class="pt-24 pb-16 relative z-10">
    <div class="container mx-auto px-6 max-w-5xl">
      <div class="text-center mb-10">
        <p class="text-xs text-violet-300 mb-2">聖地巡礼</p>
        <h1 class="text-2xl md:text-3xl font-bold gradient-text mb-3">{work.title}</h1>
        <div class="flex flex-wrap justify-center gap-3 text-sm text-gray-400">
          <span class="px-3 py-1 glass rounded-full">{formatRange(work.start, work.end)}</span>
          <span class="px-3 py-1 glass rounded-full">{posts.length}件</span>
        </div>
      </div>

      <section class="mb-8">
        <h2 class="text-sm font-semibold text-gray-400 mb-2">巡った県</h2>
        <div class="flex flex-wrap gap-2">
          {visited.map((prefecture) => (
            <a
              href={`/journey/${prefecture!.slug}/`}
              class="px-3 py-1.5 rounded-full bg-white/10 text-gray-200 text-xs hover:bg-white/20 transition-colors"
            >
              {prefecture!.name}
            </a>
          ))}
        </div>
      </section>

      <div class="section-divider"></div>

      <PostGrid posts={posts} />
    </div>
  </main>
</Layout>
