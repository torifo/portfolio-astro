---
// 都道府県ページ。訪問済みの県すべてに用意し、投稿がまだ無い県は掲載予定として出す。
import Layout from '../../layouts/Layout.astro';
import DetailHeader from '../../components/DetailHeader.astro';
import PostGrid from '../../components/journey/PostGrid.astro';
import TripCard from '../../components/journey/TripCard.astro';
import {
  prefectures,
  postsForPrefecture,
  tripsForPrefecture,
  worksForPrefecture,
  themesForPrefecture,
  areasForPrefecture,
  highlightTags,
  hasYear,
  type Prefecture,
} from '../../lib/journey';

export async function getStaticPaths() {
  return prefectures
    .filter((prefecture) => prefecture.visited)
    .map((prefecture) => ({ params: { slug: prefecture.slug }, props: { prefecture } }));
}

interface Props {
  prefecture: Prefecture;
}

const { prefecture } = Astro.props;
const posts = postsForPrefecture(prefecture.code);
const trips = tripsForPrefecture(prefecture.code);
const works = worksForPrefecture(prefecture.code);
const themes = themesForPrefecture(prefecture.code);

// 見出しの下：投稿に書いたエリア（北海道(旭川) など）。無い県は手書きの note
const areas = areasForPrefecture(prefecture, posts);
const subtitle = areas.length > 0 ? areas.join('・') : prefecture.note;
// ハイライト：この県の投稿でよく付けたタグ（以前の「この県で食べたもの」は「ネカフェ」がカフェに当たった）
const highlights = highlightTags(posts);

const years = [...new Set(posts.filter(hasYear).map((post) => post.date.slice(0, 4)))].sort();
const yearLabel =
  years.length === 0 ? '' : years.length === 1 ? `${years[0]}年` : `${years[0]}年〜${years[years.length - 1]}年`;
---

<Layout
  title={`${prefecture.name}の記録 - Toriforium Portfolio`}
  description={`${prefecture.name}で撮った写真${posts.length}件。${subtitle ?? ''}`}
>
  <DetailHeader title={prefecture.name} backHref="/#journey" backLabel="旅の記録に戻る" />

  <main class="pt-24 pb-16 relative z-10">
    <div class="container mx-auto px-6 max-w-5xl">
      <div class="text-center mb-10">
        <h1 class="text-3xl md:text-4xl font-bold gradient-text mb-3">{prefecture.name}</h1>
        {areas.length > 0 ? (
          // エリアは「・」の後でだけ折り返す（「すす / きの」と語の途中で切れないように）
          <p class="text-gray-400 mb-3 break-keep">
            {areas.map((area, i) => (
              <>{i > 0 && <>・<wbr /></>}{area}</>
            ))}
          </p>
        ) : (
          prefecture.note && <p class="text-gray-400 mb-3">{prefecture.note}</p>
        )}
        <div class="flex flex-wrap justify-center gap-3 text-sm text-gray-400">
          <span class="px-3 py-1 glass rounded-full">投稿{posts.length}件</span>
          {yearLabel && <span class="px-3 py-1 glass rounded-full">{yearLabel}</span>}
          {trips.length > 0 && <span class="px-3 py-1 glass rounded-full">旅{trips.length}件</span>}
        </div>
      </div>

      {highlights.length > 0 && (
        <section class="mb-10">
          <h2 class="text-lg font-semibold text-white mb-3">ハイライト</h2>
          <div class="flex flex-wrap gap-2">
            {highlights.map(({ tag, count }) => (
              <span class="px-3 py-1 rounded-full bg-amber-500/15 text-amber-200 text-xs">
                #{tag}<span class="ml-1.5 opacity-60">{count}</span>
              </span>
            ))}
          </div>
        </section>
      )}

      {trips.length > 0 && (
        <section class="mb-10">
          <h2 class="text-lg font-semibold text-white mb-3">この県を含む旅</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
            {trips.map((trip) => (
              <TripCard trip={trip} compact />
            ))}
          </div>
        </section>
      )}

      {works.length > 0 && (
        <section class="mb-10">
          <h2 class="text-lg font-semibold text-white mb-3">この県の聖地巡礼</h2>
          <div class="flex flex-wrap gap-2">
            {works.map((work) => (
              <a
                href={`/journey/pilgrimage/${work.slug}/`}
                class="px-3 py-1.5 rounded-full bg-violet-500/15 text-violet-200 text-xs hover:bg-violet-500/25 transition-colors"
              >
                {work.title}
              </a>
            ))}
          </div>
        </section>
      )}

      {themes.length > 0 && (
        <section class="mb-10">
          <h2 class="text-lg font-semibold text-white mb-3">この県で撮ったもの</h2>
          <div class="flex flex-wrap gap-2">
            {themes.map((theme) => (
              <a
                href={`/journey/themes/${theme.slug}/`}
                class="px-3 py-1.5 rounded-full bg-cyan-500/15 text-cyan-200 text-xs hover:bg-cyan-500/25 transition-colors"
              >
                {theme.title}
              </a>
            ))}
          </div>
        </section>
      )}

      <div class="section-divider"></div>

      {posts.length > 0 ? (
        <PostGrid posts={posts} omitPrefCode={prefecture.code} />
      ) : (
        <div class="glass rounded-2xl p-10 text-center">
          <p class="text-gray-300 mb-2">{prefecture.name}は訪れましたが、写真はまだ整理中です。</p>
          <p class="text-gray-500 text-sm">今後掲載予定</p>
        </div>
      )}
    </div>
  </main>
</Layout>
