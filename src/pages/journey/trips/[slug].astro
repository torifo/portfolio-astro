---
// 旅ページ。旅グループタグ（本人が旅ごとに付けている一文まるごとのタグ）でまとめる。
import Layout from '../../../layouts/Layout.astro';
import DetailHeader from '../../../components/DetailHeader.astro';
import PostGrid from '../../../components/journey/PostGrid.astro';
import {
  trips,
  postsForTrip,
  prefectureByCode,
  formatRange,
  hasDay,
  coverFor,
  type Trip,
} from '../../../lib/journey';

export async function getStaticPaths() {
  return trips.map((trip) => ({ params: { slug: trip.slug }, props: { trip } }));
}

interface Props {
  trip: Trip;
}

const { trip } = Astro.props;
const posts = postsForTrip(trip).slice().sort((a, b) => a.date.localeCompare(b.date));
const visited = trip.allPrefCodes.map((code) => prefectureByCode(code)).filter(Boolean);
const days = [...new Set(posts.filter(hasDay).map((post) => post.date))];
const cover = coverFor(trip);
---

<Layout title={`${trip.title} - Toriforium Portfolio`} description={`${formatRange(trip.start, trip.end)}の旅・${posts.length}件`}>
  <DetailHeader title={trip.title} backHref="/#journey" backLabel="旅の記録に戻る" />

  <main class="pt-24 pb-16 relative z-10">
    <div class="container mx-auto px-6 max-w-5xl">
      <!-- 画像は形を崩さず全体を見せ、余白は端を鏡に映して延ばした画像のぼかしでつなぐ（global.css の cover-*）。スマホは 4:3 -->
      <div class="trip-hero relative overflow-hidden rounded-2xl aspect-[4/3] md:aspect-auto md:h-[30rem] mb-10">
        {cover && (
          <>
            {cover.fill ? (
              <img
                src={cover.fill}
                alt=""
                aria-hidden="true"
                decoding="async"
                class:list={[
                  'cover-fill absolute left-1/2 top-1/2 max-w-none',
                  cover.shape === 'wide' ? 'hero-fill-wide' : 'hero-fill',
                ]}
              />
            ) : (
              <img
                src={cover.src}
                srcset={cover.srcset}
                sizes="(min-width: 1024px) 976px, 100vw"
                alt=""
                aria-hidden="true"
                decoding="async"
                class="cover-backdrop absolute inset-0 w-full h-full object-cover"
              />
            )}
            <img
              src={cover.src}
              srcset={cover.srcset}
              sizes="(min-width: 768px) 480px, 75vw"
              alt=""
              decoding="async"
              fetchpriority="high"
              class:list={['absolute', cover.shape === 'wide' ? 'hero-wide' : 'cover-fade top-0 left-1/2 -translate-x-1/2 h-full w-auto max-w-none']}
            />
          </>
        )}
        <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent"></div>
        <div class="relative h-full flex flex-col justify-end items-center text-center p-6">
          <h1 class="photo-title text-2xl md:text-3xl font-bold mb-3">{trip.title}</h1>
          <div class="flex flex-wrap justify-center gap-2 text-sm">
            <span class="photo-chip px-3 py-1 rounded-full">{formatRange(trip.start, trip.end)}</span>
            <span class="photo-chip px-3 py-1 rounded-full">{days.length}日・{posts.length}件</span>
          </div>
        </div>
      </div>

      <section class="mb-8">
        <h2 class="text-sm font-semibold text-gray-400 mb-2">通った県</h2>
        <div class="flex flex-wrap gap-2">
          {visited.map((prefecture) => (
            <a
              href={`/journey/${prefecture!.slug}/`}
              class="px-3 py-1.5 rounded-full bg-white/10 text-gray-200 text-xs hover:bg-white/20 transition-colors"
            >
              {prefecture!.name}
            </a>
          ))}
        </div>
      </section>

      {trip.spots.length > 0 && (
        <section class="mb-8">
          <h2 class="text-sm font-semibold text-gray-400 mb-2">立ち寄り先</h2>
          <div class="flex flex-wrap gap-2">
            {trip.spots.map((spot) => (
              <span class="px-3 py-1 rounded-full bg-cyan-500/15 text-cyan-200 text-xs">#{spot}</span>
            ))}
          </div>
        </section>
      )}

      <div class="section-divider"></div>

      <PostGrid posts={posts} />
    </div>
  </main>
</Layout>

<style>
  .trip-hero {
    background: #0f172a;
  }
  /* 見出しは横に長く、左右の画像が大きく引き伸ばされて形が残るので、カードより強くぼかす */
  .trip-hero .cover-backdrop {
    filter: blur(28px) brightness(0.8);
    transform: scale(1.15);
  }
  .trip-hero .cover-fill {
    filter: blur(28px) brightness(0.8);
  }
  /* 見出しはぼかしが強いので、くっきりした画像からぼけた余白への切り替えを広くとる（カードは6%）。
     6% だと切り替えが急で、余白の絵が端の続きになっていても画像がそこで切れて見えた */
  .trip-hero .cover-fade {
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 16%, #000 84%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 16%, #000 84%, transparent 100%);
  }
  /* 余白用の画像（上下左右に 0.75 倍ずつ延ばしてある）を、手前の画像の 250% の大きさで中央に重ねる。
     手前が高さに合わせる形なら高さで、幅に合わせる形（スマホの横長）なら幅で合わせる */
  .hero-fill {
    height: 250%;
    width: auto;
    transform: translate(-50%, -50%);
  }
  .hero-fill-wide {
    width: 250%;
    height: auto;
    transform: translate(-50%, -50%);
  }
  @media (min-width: 768px) {
    .hero-fill-wide {
      height: 250%;
      width: auto;
    }
  }
  /* 4:3 より横長の画像。スマホの帯（4:3）では幅に合わせて上下をつなぎ、md 以上の帯（画像より横長）では
     ほかの画像と同じく高さに合わせて左右をつなぐ。スマホで左右が切れて、端の文字が欠けていた */
  .hero-wide {
    left: 0;
    top: 50%;
    width: 100%;
    height: auto;
    transform: translateY(-50%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 6%, #000 94%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 6%, #000 94%, transparent 100%);
  }
  @media (min-width: 768px) {
    .hero-wide {
      left: 50%;
      top: 0;
      width: auto;
      max-width: none;
      height: 100%;
      transform: translateX(-50%);
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 16%, #000 84%, transparent 100%);
      mask-image: linear-gradient(to right, transparent 0, #000 16%, #000 84%, transparent 100%);
    }
  }
</style>
