{
  "name": "portfolio-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "journey:sync": "python3 scripts/ingest/sync_instagram.py && npm run journey:build",
    "journey:refresh": "python3 scripts/ingest/refresh_captions.py && npm run journey:build",
    "journey:covers": "python3 scripts/journey/build_trip_covers.py",
    "journey:build": "python3 scripts/journey/apply_date_overrides.py && python3 scripts/journey/resolve.py && python3 scripts/journey/build_trips.py --merge && python3 scripts/journey/build_pilgrimages.py --merge && python3 scripts/journey/build_themes.py",
    "journey:work-covers": "python3 scripts/journey/build_work_covers.py",
    "journey:islands": "python3 scripts/journey/build_islands.py"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "astro": "^7.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5"
  }
}
